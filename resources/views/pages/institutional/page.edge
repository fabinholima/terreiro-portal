@layout()
  @if(page.slug === 'o-terreiro')
    <section class="institutional-hero">
      <div class="site-container institutional-hero__inner">
        <div class="institutional-hero__logo-wrap">
          <img class="institutional-hero__logo" src="/images/logo-terreiro.svg" alt="Logotipo do {{ siteSettings.siteName }}">
        </div>
        <div>
          <p class="eyebrow">{{ page.eyebrow ?? 'Institucional' }}</p>
          <h1 class="institutional-hero__title">{{ page.title }}</h1>
          <div class="gold-rule" aria-hidden="true"><span></span></div>
          <p class="institutional-hero__summary">{{ page.summary ?? 'Casa de fé, caridade, ancestralidade e acolhimento.' }}</p>
        </div>
      </div>
    </section>

    <section class="institutional-content">
      <div class="site-container institutional-list">
        <article class="institutional-item">
          <div class="institutional-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M24 39s-14-8.2-14-19a8 8 0 0 1 14-5.2A8 8 0 0 1 38 20c0 10.8-14 19-14 19Z"/><path d="M8 35h8l4-4h9a4 4 0 0 1 4 4H20"/><path d="M8 31H4v12h4"/></svg>
          </div>
          <div>
            <h2>Nossa missão</h2>
            <p>{{ page.body.split('\n\n')[0] ?? '' }}</p>
          </div>
        </article>

        <article class="institutional-item">
          <div class="institutional-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><circle cx="24" cy="16" r="7"/><circle cx="11" cy="20" r="5"/><circle cx="37" cy="20" r="5"/><path d="M12 38v-5c0-6 5-10 12-10s12 4 12 10v5"/><path d="M3 38v-4c0-5 3-8 8-8M45 38v-4c0-5-3-8-8-8"/></svg>
          </div>
          <div>
            <h2>Nossos valores</h2>
            <p>{{ page.body.split('\n\n')[1] ?? '' }}</p>
          </div>
        </article>

        <article class="institutional-item">
          <div class="institutional-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M7 22 24 8l17 14v20H7Z"/><path d="M24 42V25"/><path d="M24 33c-6 0-9-4-9-9 6 0 9 3 9 9Zm0 0c6 0 9-4 9-9-6 0-9 3-9 9Z"/></svg>
          </div>
          <div>
            <h2>Nossa trajetória</h2>
            <p>{{ page.body.split('\n\n')[2] ?? '' }}</p>
          </div>
        </article>

        <div class="institutional-cta">
          <a class="button" href="/nossa-historia">Conheça nossa história →</a>
        </div>
      </div>
    </section>
  @else
    <section class="page-hero">
      <div class="site-container">
        <p class="eyebrow">{{ page.eyebrow ?? 'Institucional' }}</p>
        <h1>{{ page.title }}</h1>
        @if(page.summary)
          <p class="section-lead">{{ page.summary }}</p>
        @end
      </div>
    </section>

    <section class="article-shell">
      @each(paragraph in page.body.split('\n\n'))
        <p>{{ paragraph }}</p>
      @end

      @if(page.slug === 'contato')
        <div class="contact-grid">
          @if(siteSettings.phone || siteSettings.whatsapp || siteSettings.email || siteSettings.instagramUrl || siteSettings.facebookUrl || siteSettings.youtubeUrl)
            <article class="contact-card">
              <h2>Canais oficiais</h2>
              @if(siteSettings.phone)<p><strong>Telefone:</strong> {{ siteSettings.phone }}</p>@end
              @if(siteSettings.whatsapp)<p><strong>WhatsApp:</strong> {{ siteSettings.whatsapp }}</p>@end
              @if(siteSettings.email)<p><strong>E-mail:</strong> <a href="mailto:{{ siteSettings.email }}">{{ siteSettings.email }}</a></p>@end
              @if(siteSettings.instagramUrl)<p><a href="{{ siteSettings.instagramUrl }}" target="_blank" rel="noopener">Instagram</a></p>@end
              @if(siteSettings.facebookUrl)<p><a href="{{ siteSettings.facebookUrl }}" target="_blank" rel="noopener">Facebook</a></p>@end
              @if(siteSettings.youtubeUrl)<p><a href="{{ siteSettings.youtubeUrl }}" target="_blank" rel="noopener">YouTube</a></p>@end
            </article>
          @end

          @if(siteSettings.address || siteSettings.city || siteSettings.openingHours || siteSettings.mapsUrl)
            <article class="contact-card contact-card--soft">
              <h2>Endereço e atendimento</h2>
              @if(siteSettings.address)<p>{{ siteSettings.address }}</p>@end
              @if(siteSettings.city || siteSettings.state)<p>{{ siteSettings.city ?? '' }}{{ siteSettings.city && siteSettings.state ? ' - ' : '' }}{{ siteSettings.state ?? '' }}{{ siteSettings.postalCode ? ' · CEP ' + siteSettings.postalCode : '' }}</p>@end
              @if(siteSettings.openingHours)<p>{{ siteSettings.openingHours }}</p>@end
              @if(siteSettings.mapsUrl)<p><a class="button" href="{{ siteSettings.mapsUrl }}" target="_blank" rel="noopener">Abrir localização no mapa</a></p>@end
            </article>
          @end
        </div>
      @end
    </section>
  @end
@end

@layout()
  <section class="page-hero">
    <div class="site-container">
      @if(page.eyebrow)
        <p class="eyebrow">{{ page.eyebrow }}</p>
      @end
      <h1>{{ page.title }}</h1>
      @if(page.summary)
        <p>{{ page.summary }}</p>
      @end
    </div>
  </section>

  <section class="site-section">
    <div class="page-content">
      <div class="page-content__body">{{ page.body }}</div>

      @if(page.slug === 'contato')
        <div class="intro-panel" style="margin-top:36px">
          <strong>Canais oficiais</strong>
          @if(siteSettings.address)
            <p>{{ siteSettings.address }}{{ siteSettings.city ? ' · ' + siteSettings.city : '' }}{{ siteSettings.state ? '/' + siteSettings.state : '' }}</p>
          @end
          @if(siteSettings.phone)
            <p>Telefone: {{ siteSettings.phone }}</p>
          @end
          @if(siteSettings.whatsapp)
            <p>WhatsApp: {{ siteSettings.whatsapp }}</p>
          @end
          @if(siteSettings.email)
            <p>E-mail: <a class="text-link" href="mailto:{{ siteSettings.email }}">{{ siteSettings.email }}</a></p>
          @end
          @if(siteSettings.openingHours)
            <p>{{ siteSettings.openingHours }}</p>
          @end
          @if(siteSettings.mapsUrl)
            <a href="{{ siteSettings.mapsUrl }}" target="_blank" rel="noopener" class="btn btn--green">Ver localização</a>
          @end
        </div>
      @end
    </div>
  </section>
@end

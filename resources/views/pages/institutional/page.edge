    </section>
  @else
    <section class="page-hero">
      <div class="site-container">
        @if(page.eyebrow)
          <p class="eyebrow">{{ page.eyebrow }}</p>
        @end
        <h1>{{ page.title }}</h1>
        @if(page.summary)
          <p class="section-lead">{{ page.summary }}</p>
        @end
      </div>
    </section>

    <section class="article-shell">
      <div class="page-content__body">{{ page.body }}</div>

      @if(page.slug === 'contato')
        <div class="contact-grid">
          <article class="contact-card">
            <h2>Canais oficiais</h2>
            @if(siteSettings.phone)
              <p><strong>Telefone:</strong> {{ siteSettings.phone }}</p>
            @end
            @if(siteSettings.whatsapp)
              <p><strong>WhatsApp:</strong> {{ siteSettings.whatsapp }}</p>
            @end
            @if(siteSettings.email)
              <p><strong>E-mail:</strong> <a href="mailto:{{ siteSettings.email }}">{{ siteSettings.email }}</a></p>
            @end
          </article>

          <article class="contact-card contact-card--soft">
            <h2>Endereço e atendimento</h2>
            @if(siteSettings.address)
              <p>{{ siteSettings.address }}</p>
            @end
            @if(siteSettings.city || siteSettings.state)
              <p>{{ siteSettings.city ?? '' }}{{ siteSettings.city && siteSettings.state ? ' - ' : '' }}{{ siteSettings.state ?? '' }}</p>
            @end
            @if(siteSettings.openingHours)
              <p>{{ siteSettings.openingHours }}</p>
            @end
            @if(siteSettings.mapsUrl)
              <p><a class="button" href="{{ siteSettings.mapsUrl }}" target="_blank" rel="noopener">Abrir localização no mapa</a></p>
            @end
          </article>
        </div>
      @end
    </section>
  @end
@end

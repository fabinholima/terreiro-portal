@layout()
  <section class="page-hero">
    <div class="site-container">
      <p class="eyebrow">Programação</p>
      <h1>Agenda</h1>
      <p>Confira as próximas atividades públicas do Terreiro e as orientações de cada encontro.</p>
    </div>
  </section>

  <section class="site-section site-section--soft">
    <div class="site-container">
      <div class="event-list">
        @each(event in events)
          <article class="event-row">
            @if(event.imagePath)
              <div class="event-row__image">
                <img src="{{ event.imagePath }}" alt="Imagem do evento {{ event.title }}">
              </div>
            @end

            <div class="event-date">
              <strong>{{ event.startsAt.toFormat('dd/LL') }}</strong>
              <span>{{ event.startsAt.toFormat('HH:mm') }}</span>
            </div>

            <div>
              <h2>{{ event.title }}</h2>
              <p>{{ event.category ?? 'Atividade pública' }}{{ event.location ? ' · ' + event.location : '' }}</p>

              @if(event.description)
                <p>{{ event.description }}</p>
              @end

              @if(event.endsAt)
                <p class="meta">Término: {{ event.endsAt.toFormat('dd/LL/yyyy · HH:mm') }}</p>
              @end
            </div>

            <span class="badge">
              @if(event.status === 'scheduled')
                Agendado
              @elseif(event.status === 'confirmed')
                Confirmado
              @elseif(event.status === 'postponed')
                Adiado
              @elseif(event.status === 'cancelled')
                Cancelado
              @else
                Concluído
              @end
            </span>
          </article>
        @else
          <div class="empty-state">Nenhuma atividade pública agendada no momento.</div>
        @end
      </div>
    </div>
  </section>
@end

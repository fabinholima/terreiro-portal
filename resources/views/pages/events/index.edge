@layout()
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="mb-10">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Programação</p>
      <h1 class="mt-2 text-4xl font-bold">Agenda</h1>
      <p class="mt-3 max-w-3xl text-slate-600">Confira as próximas atividades públicas do Terreiro de Umbanda Oxóssi e João Boiadeiro.</p>
    </div>

    <div class="space-y-4">
      @each(event in events)
        <article class="rounded-xl border border-slate-200 bg-white p-6 md:flex md:items-start md:justify-between md:gap-8">
          <div>
            <div class="mb-2 flex flex-wrap gap-3 text-sm text-slate-500">
              <span>{{ event.startsAt.toFormat('dd/LL/yyyy HH:mm') }}</span>
              @if(event.category)
                <span>• {{ event.category }}</span>
              @end
              @if(event.location)
                <span>• {{ event.location }}</span>
              @end
            </div>
            <h2 class="text-2xl font-bold">{{ event.title }}</h2>
            @if(event.description)
              <p class="mt-3 text-slate-600">{{ event.description }}</p>
            @end
          </div>
          <span class="mt-4 inline-flex rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-800 md:mt-0">{{ event.status }}</span>
        </article>
      @else
        <p class="rounded-xl border border-slate-200 bg-white p-6 text-slate-600">Nenhuma atividade pública agendada no momento.</p>
      @end
    </div>
  </section>
@end

@layout()
  <section class="page-hero">
    <div class="site-container">
      <p class="eyebrow">Solidariedade e comunidade</p>
      <h1>Ações sociais</h1>
      <p>Conheça as campanhas e iniciativas promovidas pelo Terreiro de Umbanda Oxóssi e João Boiadeiro.</p>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container">
      <div class="card-grid">
        @each(action in actions)
          <article class="card">
            <div class="card__body">
              <p class="card__meta">{{ action.status }}{{ action.startsAt ? ' · ' + action.startsAt.toFormat('dd/LL/yyyy') : '' }}</p>
              <h3>{{ action.title }}</h3>
              @if(action.description)
                <p>{{ action.description }}</p>
              @end

              @if(action.progressPercent !== null)
                <div class="progress"><span style="width: {{ action.progressPercent }}%"></span></div>
                <div class="progress-label">
                  <span>{{ action.currentValue }} de {{ action.goal }} {{ action.unit ?? '' }}</span>
                  <strong>{{ action.progressPercent }}%</strong>
                </div>
              @end
            </div>
          </article>
        @else
          <div class="empty-state">Nenhuma ação social publicada no momento.</div>
        @end
      </div>
    </div>
  </section>
@end

<section class="bg-emerald-950 py-20 text-white">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-amber-300">Solidariedade e comunidade</p>
    <h1 class="mt-3 text-4xl font-bold md:text-5xl">Ações sociais</h1>
    <p class="mt-5 max-w-2xl text-lg text-emerald-50">Conheça as campanhas e iniciativas promovidas pelo Terreiro de Umbanda Oxóssi e João Boiadeiro.</p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-6 py-14">
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    @each(action in actions)
      <article class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm">
        <div class="mb-4 flex items-center justify-between gap-3">
          <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-900">{{ action.status }}</span>
          @if(action.startsAt)
            <time class="text-sm text-zinc-500">{{ action.startsAt.toFormat('dd/LL/yyyy') }}</time>
          @endif
        </div>
        <h2 class="text-2xl font-bold text-zinc-900">{{ action.title }}</h2>
        <p class="mt-3 text-zinc-600">{{ action.description ?? '' }}</p>

        @if(action.progressPercent !== null)
          <div class="mt-6">
            <div class="mb-2 flex justify-between text-sm text-zinc-600"><span>Progresso</span><strong>{{ action.progressPercent }}%</strong></div>
            <div class="h-3 overflow-hidden rounded-full bg-zinc-200"><div class="h-full rounded-full bg-emerald-700" style="width: {{ action.progressPercent }}%"></div></div>
            <p class="mt-2 text-sm text-zinc-600">{{ action.currentValue }} de {{ action.goal }} {{ action.unit ?? '' }}</p>
          </div>
        @endif
      </article>
    @else
      <p class="text-zinc-600">Nenhuma ação social publicada no momento.</p>
    @end
  </div>
</section>

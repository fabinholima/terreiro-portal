@layout()
  <section class="page-hero">
    <div class="site-container">
      <p class="eyebrow">Transparência</p>
      <h1>Documentos públicos</h1>
      <p>Estatuto, regimento, atas, editais, relatórios e demais documentos disponibilizados pelo Terreiro.</p>
    </div>
  </section>

  <section class="site-section site-section--soft">
    <div class="site-container">
      <div class="document-list">
        @each(document in documents)
          <article class="document-row">
            <div>
              <div class="document-meta">
                {{ document.category ?? 'Documento' }}
                @if(document.version)
                  · Versão {{ document.version }}
                @end
                @if(document.documentDate)
                  · {{ document.documentDate.toFormat('dd/LL/yyyy') }}
                @end
              </div>
              <h2>{{ document.title }}</h2>
              @if(document.description)
                <p>{{ document.description }}</p>
              @end
            </div>
            <a href="{{ document.filePath }}" target="_blank" rel="noopener" class="btn btn--green">Abrir PDF</a>
          </article>
        @else
          <div class="empty-state">Nenhum documento público disponível no momento.</div>
        @end
      </div>
    </div>
  </section>
@end

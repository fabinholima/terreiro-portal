@layout()
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="mb-10">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Comunicação</p>
      <h1 class="mt-2 text-4xl font-bold">Notícias</h1>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      @each(post in posts)
        <article class="rounded-xl border border-slate-200 bg-white p-6">
          <p class="text-sm text-slate-500">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy') : '' }}</p>
          <h2 class="mt-2 text-2xl font-bold">{{ post.title }}</h2>
          <p class="mt-3 text-slate-600">{{ post.summary ?? '' }}</p>
          <a href="/noticias/{{ post.slug }}" class="mt-5 inline-block font-semibold text-emerald-800 underline">Ler notícia</a>
        </article>
      @else
        <p class="text-slate-600">Nenhuma notícia publicada no momento.</p>
      @end
    </div>
  </section>
@end

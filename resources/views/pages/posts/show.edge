@layout()
  <article class="mx-auto max-w-3xl px-6 py-12">
    <a href="/noticias" class="text-sm text-slate-600 underline">← Todas as notícias</a>
    <p class="mt-8 text-sm text-slate-500">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy HH:mm') : '' }}</p>
    <h1 class="mt-2 text-4xl font-bold leading-tight">{{ post.title }}</h1>

    @if(post.summary)
      <p class="mt-5 text-xl text-slate-600">{{ post.summary }}</p>
    @end

    @if(post.featuredImagePath)
      <img src="{{ post.featuredImagePath }}" alt="{{ post.title }}" class="mt-8 max-h-[520px] w-full rounded-xl object-cover">
    @end

    <div class="prose prose-slate mt-8 max-w-none whitespace-pre-line">{{ post.body ?? '' }}</div>

    @if(post.imagePaths && post.imagePaths.length)
      <section class="mt-10">
        <h2 class="mb-4 text-2xl font-bold">Fotos e figuras</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          @each(image in post.imagePaths)
            <a href="{{ image }}" target="_blank" rel="noopener">
              <img src="{{ image }}" alt="Imagem relacionada à notícia {{ post.title }}" class="h-64 w-full rounded-xl object-cover">
            </a>
          @end
        </div>
      </section>
    @end
  </article>
@end

@layout()
  <article class="article">
    <a href="/noticias" class="article__back">← Todas as notícias</a>
    <p class="article__date">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy HH:mm') : '' }}</p>
    <h1>{{ post.title }}</h1>

    @if(post.summary)
      <p class="article__summary">{{ post.summary }}</p>
    @end

    @if(post.featuredImagePath)
      <img src="{{ post.featuredImagePath }}" alt="{{ post.title }}" class="article__hero">
    @end

    <div class="article__body">{{ post.body ?? '' }}</div>

    @if(post.imagePaths && post.imagePaths.length)
      <section class="article__gallery" x-data="lightbox">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Imagens</p>
            <h2>Fotos e figuras</h2>
          </div>
        </div>
        <div class="photo-grid">
          @each(image in post.imagePaths)
            <figure class="photo-item">
              <img src="{{ image }}" alt="Imagem relacionada à notícia {{ post.title }}" @click="open('{{ image }}')">
            </figure>
          @end
        </div>
        <div class="lightbox" x-cloak x-show="image" @keydown.escape.window="close()" @click.self="close()">
          <button type="button" @click="close()" aria-label="Fechar imagem">×</button>
          <img :src="image" alt="Visualização ampliada">
        </div>
      </section>
    @end
  </article>
@end

@layout()
  <section class="gallery-hero gallery-hero--album">
    <div class="site-container">
      <a href="/galeria" class="gallery-back">← Todos os álbuns</a>
      <p class="eyebrow">Memórias da casa</p>
      <h1>{{ album.title }}</h1>
      @if(album.description)
        <p class="gallery-description">{{ album.description }}</p>
      @end
      <div class="gallery-album-meta">
        <span>{{ album.eventDate ? album.eventDate.toFormat('dd/LL/yyyy') : 'Memória da casa' }}</span>
        <span aria-hidden="true">·</span>
        <span>{{ album.photos.length }} {{ album.photos.length === 1 ? 'fotografia' : 'fotografias' }}</span>
      </div>
    </div>
  </section>

  <section class="gallery-section" x-data="galleryViewer">
    <div class="site-container">
      <div class="gallery-toolbar"><span>Um olhar sobre nossos encontros</span><span class="gallery-toolbar__hint"><span x-text="favoriteCount"></span> favoritas · Toque nas fotos para ampliar ↗</span></div>
      <div class="gallery-photo-grid">
        @each(photo in album.photos)
          <figure class="gallery-photo" data-gallery-photo data-src="{{ photo.path }}" data-alt="{{ photo.altText ?? album.title }}" data-caption="{{ photo.caption ?? '' }}" data-credit="{{ photo.credit ?? '' }}">
            <button type="button" class="gallery-photo__button" @click="open($el)" aria-label="Ampliar foto: {{ photo.altText ?? album.title }}">
              <img src="{{ photo.path }}" alt="{{ photo.altText ?? album.title }}" loading="lazy">
              <span class="gallery-photo__zoom" aria-hidden="true">↗</span>
            </button>
            <button type="button" class="gallery-photo__favorite" :class="isFavorite('{{ photo.path }}') ? 'is-favorite' : ''" @click.stop="toggleFavorite('{{ photo.path }}')" :aria-label="isFavorite('{{ photo.path }}') ? 'Remover dos favoritos' : 'Adicionar aos favoritos'" :aria-pressed="isFavorite('{{ photo.path }}')">☆<span aria-hidden="true">★</span></button>
            @if(photo.caption || photo.credit)
              <figcaption class="gallery-photo__caption">
                @if(photo.caption)
                  <span>{{ photo.caption }}</span>
                @end
                @if(photo.credit)
                  <small>Foto: {{ photo.credit }}</small>
                @end
              </figcaption>
            @end
          </figure>
        @else
          <div class="gallery-empty">As memórias deste álbum estarão aqui em breve.</div>
        @end
      </div>
      <a href="/galeria" class="gallery-end-link">← Explorar outros álbuns</a>
    </div>

    <dialog class="gallery-lightbox" x-ref="viewer" aria-label="Visualizador de fotografias" @cancel.prevent="close()" @click.self="close()" @keydown.arrow-left.prevent="previous()" @keydown.arrow-right.prevent="next()" @touchstart.passive="touchX = $event.changedTouches[0].clientX" @touchend.passive="swipe($event)">
      <div class="gallery-lightbox__top"><span>Memórias da casa</span><button class="gallery-lightbox__close" type="button" @click="close()" aria-label="Fechar imagem" autofocus>×</button></div>
      <button class="gallery-lightbox__nav gallery-lightbox__nav--prev" x-show="photos.length > 1" type="button" @click="previous()" aria-label="Foto anterior">←</button>
      <figure class="gallery-lightbox__content">
        <img :src="current.src || ''" :alt="current.alt || ''">
        <figcaption><p x-text="current.caption"></p><small x-show="current.credit" x-text="'Foto: ' + current.credit"></small><span class="gallery-lightbox__counter" aria-live="polite" x-text="counter"></span></figcaption>
      </figure>
      <button class="gallery-lightbox__nav gallery-lightbox__nav--next" x-show="photos.length > 1" type="button" @click="next()" aria-label="Próxima foto">→</button>
    </dialog>
  </section>
@end

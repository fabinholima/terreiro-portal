@layout()
  <section class="hero-public">
    <div class="site-container hero-public__inner">
      <p class="eyebrow">Em atividade desde 1991</p>
      <h1>{{ siteSettings.siteName }}</h1>
      <p class="hero-public__lead">Uma casa de fé, caridade, ancestralidade, acolhimento e preservação da tradição umbandista.</p>
      <div class="hero-actions">
        <a href="/o-terreiro" class="btn btn--gold">Conheça o Terreiro</a>
        <a href="/agenda" class="btn btn--ghost">Ver próxima programação</a>
      </div>
      <div class="hero-badges" aria-label="Princípios da casa">
        <span>Fé</span>
        <span>Caridade</span>
        <span>Ancestralidade</span>
        <span>Acolhimento</span>
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container intro-grid">
      <div>
        <p class="eyebrow">Nossa Casa</p>
        <h2>Uma história construída com fé e compromisso com a comunidade</h2>
        <p class="intro-copy">O Terreiro reúne tradição religiosa, memória, cuidado espiritual e ações comunitárias. Este portal organiza nossa história, programação, notícias, documentos e registros públicos em um só lugar.</p>
        <a href="/nossa-historia" class="text-link">Conhecer nossa história</a>
      </div>
      <aside class="intro-panel">
        <strong>Informação e transparência</strong>
        <p>Acompanhe os próximos trabalhos, ações sociais, documentos públicos e registros da trajetória da casa.</p>
        <a href="/documentos" class="text-link">Acessar documentos públicos</a>
      </aside>
    </div>
  </section>

  <section class="site-section site-section--soft">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Programação</p>
          <h2>Próximas atividades</h2>
          <p>Consulte datas, horários e informações das próximas atividades públicas.</p>
        </div>
        <a href="/agenda" class="text-link">Agenda completa</a>
      </div>

      <div class="card-grid">
        @each(event in events)
          <article class="card">
            <div class="card__body">
              <p class="card__meta">{{ event.startsAt.toFormat('dd/LL/yyyy · HH:mm') }}</p>
              <h3>{{ event.title }}</h3>
              @if(event.location)
                <p>{{ event.location }}</p>
              @end
              @if(event.description)
                <p>{{ event.description }}</p>
              @end
            </div>
          </article>
        @else
          <div class="empty-state">Nenhuma atividade pública agendada no momento.</div>
        @end
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Comunicação</p>
          <h2>Notícias recentes</h2>
          <p>Atualizações, comunicados e registros das atividades do Terreiro.</p>
        </div>
        <a href="/noticias" class="text-link">Todas as notícias</a>
      </div>

      <div class="card-grid">
        @each(post in posts)
          <article class="card">
            @if(post.featuredImagePath)
              <img src="{{ post.featuredImagePath }}" alt="{{ post.title }}" class="card__image">
            @end
            <div class="card__body">
              <p class="card__meta">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy') : '' }}</p>
              <h3>{{ post.title }}</h3>
              @if(post.summary)
                <p>{{ post.summary }}</p>
              @end
              <a href="/noticias/{{ post.slug }}" class="card__link">Ler notícia →</a>
            </div>
          </article>
        @else
          <div class="empty-state">Nenhuma notícia publicada.</div>
        @end
      </div>
    </div>
  </section>

  <section class="site-section site-section--soft">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Caridade</p>
          <h2>Ações sociais</h2>
          <p>Campanhas e iniciativas desenvolvidas em benefício da comunidade.</p>
        </div>
        <a href="/acoes-sociais" class="text-link">Ver todas</a>
      </div>

      <div class="card-grid">
        @each(action in actions)
          <article class="card">
            <div class="card__body">
              <p class="card__meta">{{ action.status }}</p>
              <h3>{{ action.title }}</h3>
              @if(action.description)
                <p>{{ action.description }}</p>
              @end
              @if(action.progressPercent !== null)
                <div class="progress"><span style="width: {{ action.progressPercent }}%"></span></div>
                <div class="progress-label"><span>Progresso</span><strong>{{ action.progressPercent }}%</strong></div>
              @end
            </div>
          </article>
        @else
          <div class="empty-state">Nenhuma ação social publicada no momento.</div>
        @end
      </div>
    </div>
  </section>

  <section class="site-section site-section--dark">
    <div class="site-container">
      <div class="section-heading section-heading--dark">
        <div>
          <p class="eyebrow">Nossa memória</p>
          <h2>Galeria de fotografias</h2>
          <p>Registros das atividades, celebrações e ações realizadas pela casa.</p>
        </div>
        <a href="/galeria" class="text-link">Ver todos os álbuns</a>
      </div>

      <div class="card-grid card-grid--4">
        @each(album in albums)
          <a href="/galeria/{{ album.slug }}" class="card card--dark">
            @if(album.coverPath)
              <img src="{{ album.coverPath }}" alt="{{ album.title }}" class="card__image">
            @end
            <div class="card__body">
              <p class="card__meta">{{ album.eventDate ? album.eventDate.toFormat('dd/LL/yyyy') : 'Memória' }}</p>
              <h3>{{ album.title }}</h3>
            </div>
          </a>
        @else
          <div class="empty-state">Nenhum álbum público disponível.</div>
        @end
      </div>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container intro-grid">
      <div>
        <p class="eyebrow">Visite e acompanhe</p>
        <h2>Consulte os canais oficiais antes de participar</h2>
        <p class="intro-copy">Veja a agenda atualizada e utilize os canais oficiais para dúvidas sobre atividades, horários e orientações de participação.</p>
      </div>
      <div class="hero-actions">
        <a href="/contato" class="btn btn--green">Contato</a>
        <a href="/agenda" class="btn btn--outline">Consultar agenda</a>
      </div>
    </div>
  </section>
@end

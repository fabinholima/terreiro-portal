@layout()
  <section class="home-showcase">
    <div class="site-container home-showcase__inner">
      <div class="home-showcase__logo-wrap">
        <img class="home-showcase__logo" src="/images/logo-terreiro.png" alt="Logotipo do {{ siteSettings.siteName }}">
      </div>
      <div class="home-showcase__copy">
        <p class="eyebrow">{{ siteSettings.homeEyebrow ?? 'Institucional' }}</p>
        <h1>{{ siteSettings.homeTitle ?? 'O Terreiro' }}</h1>
        <div class="gold-rule" aria-hidden="true"><span></span></div>
        <p>{{ siteSettings.homeSummary ?? 'Casa de fé, caridade, ancestralidade e acolhimento.' }}</p>
      </div>
    </div>
  </section>

  <section class="home-actions" aria-label="Acesso rápido">
    <div class="site-container home-actions__grid">
      <a href="/o-terreiro" class="home-action-card"><span class="home-action-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8v9H5v-9Z"/></svg></span><span><strong>Conheça o Terreiro</strong><small>Nossa história, missão e valores</small></span><b aria-hidden="true">→</b></a>
      <a href="/agenda" class="home-action-card"><span class="home-action-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13H4V6a1 1 0 0 1 1-1Z"/></svg></span><span><strong>Veja os eventos</strong><small>Próximas atividades da casa</small></span><b aria-hidden="true">→</b></a>
      <a href="/contato" class="home-action-card"><span class="home-action-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16v12H4zM5 7l7 6 7-6"/></svg></span><span><strong>Fale conosco</strong><small>Canais oficiais e atendimento</small></span><b aria-hidden="true">→</b></a>
    </div>
  </section>

  <section class="home-values">
    <div class="site-container home-values__grid">
      @if(siteSettings.missionVisible !== false)
        <article class="home-value-card">
          <div class="institutional-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M24 39s-14-8.2-14-19a8 8 0 0 1 14-5.2A8 8 0 0 1 38 20c0 10.8-14 19-14 19Z"/><path d="M8 35h8l4-4h9a4 4 0 0 1 4 4H20"/><path d="M8 31H4v12h4"/></svg>
          </div>
          <div>
            <h2>{{ siteSettings.missionTitle ?? 'Nossa missão' }}</h2>
            <span class="mini-gold-line"></span>
            <p>{{ siteSettings.missionText }}</p>
          </div>
        </article>
      @end

      @if(siteSettings.valuesVisible !== false)
        <article class="home-value-card">
          <div class="institutional-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><circle cx="24" cy="16" r="7"/><circle cx="11" cy="20" r="5"/><circle cx="37" cy="20" r="5"/><path d="M12 38v-5c0-6 5-10 12-10s12 4 12 10v5"/><path d="M3 38v-4c0-5 3-8 8-8M45 38v-4c0-5-3-8-8-8"/></svg>
          </div>
          <div>
            <h2>{{ siteSettings.valuesTitle ?? 'Nossos valores' }}</h2>
            <span class="mini-gold-line"></span>
            <p>{{ siteSettings.valuesText }}</p>
          </div>
        </article>
      @end

      @if(siteSettings.trajectoryVisible !== false)
        <article class="home-value-card">
          <div class="institutional-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M7 22 24 8l17 14v20H7Z"/><path d="M24 42V25"/><path d="M24 33c-6 0-9-4-9-9 6 0 9 3 9 9Zm0 0c6 0 9-4 9-9-6 0-9 3-9 9Z"/></svg>
          </div>
          <div>
            <h2>{{ siteSettings.trajectoryTitle ?? 'Nossa trajetória' }}</h2>
            <span class="mini-gold-line"></span>
            <p>{{ siteSettings.trajectoryText }}</p>
            @if(siteSettings.trajectoryButtonText && siteSettings.trajectoryButtonUrl)
              <a href="{{ siteSettings.trajectoryButtonUrl }}" class="button home-value-card__button">{{ siteSettings.trajectoryButtonText }}</a>
            @end
          </div>
        </article>
      @end
    </div>
  </section>

  <section class="home-teasers">
    <div class="site-container home-teasers__grid">
      <article class="home-teaser">
        <div class="home-teaser__heading">
          <h2>Próximas atividades</h2>
          <a href="/agenda">Ver agenda →</a>
        </div>
        @each(event in events)
          <div class="home-teaser__card">
            <p class="meta">{{ event.startsAt.toFormat('dd/LL/yyyy · HH:mm') }}</p>
            <h3>{{ event.title }}</h3>
            @if(event.location)
              <p>{{ event.location }}</p>
            @end
          </div>
        @else
          <p class="home-teaser__empty">Nenhuma atividade pública agendada.</p>
        @end
      </article>

      <article class="home-teaser">
        <div class="home-teaser__heading">
          <h2>Notícias recentes</h2>
          <a href="/noticias">Ver todas →</a>
        </div>
        @each(post in posts)
          <a href="/noticias/{{ post.slug }}" class="home-teaser__card home-teaser__card--media">
            @if(post.featuredImagePath)
              <img src="{{ post.featuredImagePath }}" alt="{{ post.title }}">
            @end
            <div>
              <p class="meta">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy') : '' }}</p>
              <h3>{{ post.title }}</h3>
            </div>
          </a>
        @else
          <p class="home-teaser__empty">Nenhuma notícia publicada.</p>
        @end
      </article>

    </div>
  </section>
@end

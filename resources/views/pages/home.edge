    <div class="grid gap-6 md:grid-cols-3">
      @each(event in events)
        <article class="rounded-xl border border-slate-200 bg-white p-6">
          <p class="text-sm font-semibold text-emerald-800">{{ event.startsAt.toFormat('dd/LL/yyyy HH:mm') }}</p>
          <h3 class="mt-2 text-xl font-bold">{{ event.title }}</h3>
          @if(event.location)
            <p class="mt-2 text-sm text-slate-500">{{ event.location }}</p>
          @end
          @if(event.description)
            <p class="mt-3 text-slate-600">{{ event.description }}</p>
          @end
        </article>
      @else
        <p class="text-slate-600">Nenhuma atividade pública agendada no momento.</p>
      @end
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Comunicação</p>
          <h2 class="mt-2 text-3xl font-bold">Notícias recentes</h2>
        </div>
        <a href="/noticias" class="font-semibold text-emerald-800 underline">Todas as notícias</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        @each(post in posts)
          <article class="overflow-hidden rounded-xl border border-slate-200 bg-white">
            @if(post.featuredImagePath)
              <img src="{{ post.featuredImagePath }}" alt="{{ post.title }}" class="h-48 w-full object-cover">
            @end
            <div class="p-6">
              <p class="text-sm text-slate-500">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy') : '' }}</p>
              <h3 class="mt-2 text-xl font-bold">{{ post.title }}</h3>
              <p class="mt-3 text-slate-600">{{ post.summary ?? '' }}</p>
              <a href="/noticias/{{ post.slug }}" class="mt-4 inline-block font-semibold text-emerald-800 underline">Ler notícia</a>
            </div>
          </article>
        @else
          <p class="text-slate-600">Nenhuma notícia publicada.</p>
        @end
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Caridade</p>
        <h2 class="mt-2 text-3xl font-bold">Ações sociais</h2>

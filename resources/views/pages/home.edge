    <div class="grid gap-6 md:grid-cols-3">
      @each(action in actions)
        <article class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-xl font-bold">{{ action.title }}</h3>
          <p class="mt-3 text-slate-600">{{ action.description ?? '' }}</p>
          @if(action.progressPercent !== null)
            <div class="mt-5 h-2 overflow-hidden rounded-full bg-slate-200">
              <div class="h-full bg-emerald-700" style="width: {{ action.progressPercent }}%"></div>
            </div>
            <p class="mt-2 text-sm text-slate-500">{{ action.progressPercent }}% da meta</p>
          @end
        </article>
      @else
        <p class="text-slate-600">Nenhuma ação social publicada no momento.</p>
      @end
    </div>
  </section>


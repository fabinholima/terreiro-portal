    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Programação</p>
        <h2 class="mt-2 text-3xl font-bold">Próximas atividades</h2>

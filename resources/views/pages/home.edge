@layout()
  <section class="bg-emerald-950 text-white">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <p class="text-sm font-semibold uppercase tracking-[0.24em] text-amber-300">Em atividade desde 1991</p>
      <h1 class="mt-4 max-w-5xl text-4xl font-bold leading-tight md:text-6xl">Terreiro de Umbanda Oxóssi e João Boiadeiro</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-emerald-50">Casa de fé, caridade, ancestralidade, acolhimento e preservação da tradição umbandista.</p>

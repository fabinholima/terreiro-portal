      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @each(album in albums)
          <a href="/galeria" class="group overflow-hidden rounded-xl bg-white/10">
            <img src="{{ album.coverPath }}" alt="{{ album.title }}" class="h-56 w-full object-cover transition group-hover:scale-105">
            <div class="p-4 font-semibold">{{ album.title }}</div>
          </a>
        @else
          <p class="text-emerald-100">Nenhum álbum público com capa disponível.</p>
        @end
      </div>
    </div>

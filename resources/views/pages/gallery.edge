@layout('layouts/main')

@section('body')
<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold">Galeria</h1>
    <p class="text-gray-600">Registros públicos das atividades e eventos do Terreiro.</p>
  </div>

  <div class="grid gap-8">
    @each(album in albums)
      <section>
        <div class="mb-3">
          <h2 class="text-2xl font-semibold">{{ album.title }}</h2>
          @if(album.description)<p class="text-gray-600">{{ album.description }}</p>@endif
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          @each(photo in album.photos)
            <figure class="rounded-xl overflow-hidden border bg-white">
              <img src="{{ photo.path }}" alt="{{ photo.altText ?? album.title }}" class="w-full h-56 object-cover">
              @if(photo.caption || photo.credit)
                <figcaption class="p-3 text-sm">
                  @if(photo.caption)<p>{{ photo.caption }}</p>@endif
                  @if(photo.credit)<p class="text-gray-500">Foto: {{ photo.credit }}</p>@endif
                </figcaption>
              @endif
            </figure>
          @else
            <p class="text-gray-500">Nenhuma foto pública neste álbum.</p>
          @end
        </div>
      </section>
    @else
      <p>Nenhum álbum público disponível.</p>
    @end
  </div>
</div>
@endsection

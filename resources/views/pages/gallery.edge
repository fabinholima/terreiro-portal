@layout()
  <section class="page-hero">
    <div class="site-container">
      <p class="eyebrow">Memória</p>
      <h1>Galeria</h1>
      <p>Registros públicos das atividades, celebrações e ações do Terreiro.</p>
    </div>
  </section>

  <section class="site-section">
    <div class="site-container">
      <div class="album-grid">
        @each(album in albums)
          <a href="/galeria/{{ album.slug }}" class="album-card">
            @if(album.coverPath)
              <img src="{{ album.coverPath }}" alt="{{ album.title }}" class="album-cover">
            @else
              <div class="album-placeholder">Álbum</div>
            @end
            <div class="album-card__body">
              <h2>{{ album.title }}</h2>
              <p>{{ album.eventDate ? album.eventDate.toFormat('dd/LL/yyyy') : 'Registro da casa' }} · {{ album.photos.length }} foto(s)</p>
              @if(album.description)
                <p>{{ album.description }}</p>
              @end
            </div>
          </a>
        @else
          <div class="empty-state">Nenhum álbum público disponível.</div>
        @end
      </div>
    </div>
  </section>
@end

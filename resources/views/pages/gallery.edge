@layout()
  <section class="gallery-hero">
    <div class="site-container">
      <p class="eyebrow">Memórias da casa</p>
      <h1>Memórias</h1>
      <p>Encontros, celebrações e gestos de cuidado que fazem parte da nossa história.</p>
    </div>
  </section>

  <section class="gallery-section">
    <div class="site-container">
      <div class="gallery-album-grid">
        @each(album in albums)
          <a href="/galeria/{{ album.slug }}" class="gallery-album-card">
            <div class="gallery-album-card__media">
              @if(album.coverPath)
                <img src="{{ album.coverPath }}" alt="{{ album.title }}" loading="lazy">
              @else
                <div class="gallery-album-card__placeholder">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m5 17 4-4 3 3 2-2 5 5"/></svg>
                </div>
              @end
              <span class="gallery-album-card__count">{{ album.photos.length }} {{ album.photos.length === 1 ? 'foto' : 'fotos' }}</span>
            </div>
            <div class="gallery-album-card__body">
              <p class="gallery-album-card__meta">{{ album.eventDate ? album.eventDate.toFormat('dd/LL/yyyy') : 'Memória da casa' }}</p>
              <h2>{{ album.title }}</h2>
              @if(album.description)
                <p>{{ album.description }}</p>
              @end
              <span class="gallery-album-card__link">Abrir álbum <span>→</span></span>
            </div>
          </a>
        @else
          <div class="gallery-empty">Nenhum álbum público disponível.</div>
        @end
      </div>

      @if(pagination.lastPage > 1)
        <nav class="gallery-pagination" aria-label="Paginação de memórias">
          @if(pagination.currentPage > 1)
            <a class="gallery-pagination__link" href="/galeria?page={{ pagination.currentPage - 1 }}" rel="prev" aria-label="Página anterior">← Anterior</a>
          @else
            <span class="gallery-pagination__link gallery-pagination__link--disabled">← Anterior</span>
          @end
          <span class="gallery-pagination__status">Página {{ pagination.currentPage }} de {{ pagination.lastPage }}</span>
          @if(pagination.currentPage < pagination.lastPage)
            <a class="gallery-pagination__link" href="/galeria?page={{ pagination.currentPage + 1 }}" rel="next" aria-label="Próxima página">Próxima →</a>
          @else
            <span class="gallery-pagination__link gallery-pagination__link--disabled">Próxima →</span>
          @end
        </nav>
      @end
    </div>
  </section>
@end

@layout()
  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="mb-10">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Memória</p>
      <h1 class="mt-2 text-4xl font-bold">Galeria</h1>
      <p class="mt-3 max-w-3xl text-slate-600">Registros públicos das atividades e eventos do Terreiro de Umbanda Oxóssi e João Boiadeiro.</p>
    </div>

    <div class="space-y-12">
      @each(album in albums)
        <section>
          <div class="mb-5">
            <h2 class="text-2xl font-semibold">{{ album.title }}</h2>
            @if(album.eventDate)
              <p class="mt-1 text-sm text-slate-500">{{ album.eventDate.toFormat('dd/LL/yyyy') }}</p>
            @end
            @if(album.description)
              <p class="mt-2 text-slate-600">{{ album.description }}</p>
            @end
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @each(photo in album.photos)
              <figure class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                <img src="{{ photo.path }}" alt="{{ photo.altText ?? album.title }}" class="h-56 w-full object-cover">
                @if(photo.caption || photo.credit)
                  <figcaption class="p-4 text-sm">
                    @if(photo.caption)
                      <p>{{ photo.caption }}</p>
                    @end
                    @if(photo.credit)
                      <p class="mt-1 text-slate-500">Foto: {{ photo.credit }}</p>
                    @end
                  </figcaption>
                @end
              </figure>
            @else
              <p class="text-slate-500">Nenhuma foto autorizada para publicação neste álbum.</p>
            @end
          </div>
        </section>
      @else
        <p class="text-slate-600">Nenhum álbum público disponível.</p>
      @end
    </div>
  </section>
@end

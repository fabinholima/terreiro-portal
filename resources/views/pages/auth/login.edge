@layout()
  <div class="form-container">
    <div>
      <h1><span class="page-title-icon" aria-hidden="true">♙</span>Entrar</h1>
      <p>Informe seu e-mail e senha para acessar o painel.</p>
    </div>

    <div>
      @form({ route: 'session.store', method: 'POST' })
        <div>
          @field.root({ name: 'email' })
            @!field.label({ text: 'E-mail' })
            @!input.control({ type: 'email' })
            @!field.error()
          @end
        </div>

        <div>
          @field.root({ name: 'password' })
            @!field.label({ text: 'Senha' })
            @!input.control({ type: 'password' })
            @!field.error()
          @end
        </div>

        <div>
          @!button({ text: 'Acessar painel', type: 'submit' })
        </div>
      @end
    </div>
  </div>
@end

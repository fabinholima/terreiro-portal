<header class="border-b border-emerald-900/20 bg-emerald-950 text-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="font-bold leading-tight">
      <span class="block text-sm uppercase tracking-wider text-amber-300">Terreiro de Umbanda</span>
      <span>Oxóssi e João Boiadeiro</span>
    </a>

    <nav class="hidden items-center gap-5 text-sm font-medium md:flex" aria-label="Navegação principal">
      <a href="/">Início</a>
      <a href="/agenda">Agenda</a>
      <a href="/galeria">Galeria</a>
      <a href="/acoes-sociais">Ações sociais</a>
      <a href="/noticias">Notícias</a>
      <a href="/documentos">Documentos</a>
      @if(auth.user)
        <a href="/admin" class="rounded-md bg-amber-400 px-3 py-2 font-semibold text-emerald-950">Admin</a>
      @else
        <a href="/login" class="rounded-md border border-white/30 px-3 py-2">Entrar</a>
      @end
    </nav>
  </div>
</header>

<a class="skip-link" href="#main-content">Pular para o conteúdo</a>
<header class="site-header" x-data="{ open: false }">
  <div class="site-container site-header__inner">
    <a href="/" class="site-brand" aria-label="{{ siteSettings.siteName }} — página inicial">
      <img class="site-brand__logo" src="/images/logo-terreiro.png" alt="Logotipo do {{ siteSettings.siteName }}">
      <span class="site-brand__text"><span class="site-brand__kicker">Terreiro de Umbanda</span><span class="site-brand__name">Oxóssi e João Boiadeiro</span><span class="site-brand__eyebrow">Na fé, na lei e na caridade</span></span>
    </a>

    <nav class="site-nav" aria-label="Navegação principal">
      @each(item in publicMenu)
        @if(item.children && item.children.length)
          <div class="site-nav__group">
          <a data-nav-link href="{{ item.href }}"><span class="site-nav__icon" aria-hidden="true">⌂</span>{{ item.label }} <span class="site-nav__chevron">⌄</span></a>
            <div class="site-submenu">
              @each(child in item.children)
                <a href="{{ child.href }}">{{ child.label }}</a>
              @end
            </div>
          </div>
        @else
          <a data-nav-link href="{{ item.href }}"><span class="site-nav__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="{{ item.href === '/agenda' ? 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13H4V6a1 1 0 0 1 1-1Z' : item.href === '/galeria' ? 'M4 5h16v14H4zM8 15l3-3 2 2 2-2 3 3M8 9h.01' : item.href === '/noticias' ? 'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5' : item.href === '/documentos' ? 'M6 3h9l3 3v15H6zM14 3v4h4M9 12h6M9 16h6' : item.href === '/contato' ? 'M4 6h16v12H4zM5 7l7 6 7-6' : 'm3 11 9-8 9 8v9H5v-9Z' }}"/></svg></span>{{ item.label }}</a>
        @end
      @end
      @if(auth.user)
        <a href="/admin" class="site-nav__admin"><span aria-hidden="true">♙</span> Admin</a>
      @else
        <a href="/login" class="site-nav__admin"><span aria-hidden="true">♙</span> Entrar</a>
      @end
    </nav>

    <button class="mobile-menu-button" type="button" aria-label="Abrir menu" :aria-expanded="open" @click="open = !open"><span></span></button>
  </div>

  <nav class="mobile-nav" :class="open ? 'is-open' : ''" aria-label="Navegação móvel">
    @each(item in publicMenu)
      <a data-nav-link href="{{ item.href }}" @click="open = false"><span class="site-nav__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="{{ item.href === '/agenda' ? 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13H4V6a1 1 0 0 1 1-1Z' : item.href === '/galeria' ? 'M4 5h16v14H4zM8 15l3-3 2 2 2-2 3 3M8 9h.01' : item.href === '/noticias' ? 'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5' : item.href === '/documentos' ? 'M6 3h9l3 3v15H6zM14 3v4h4M9 12h6M9 16h6' : item.href === '/contato' ? 'M4 6h16v12H4zM5 7l7 6 7-6' : 'm3 11 9-8 9 8v9H5v-9Z' }}"/></svg></span>{{ item.label }}</a>
      @if(item.children && item.children.length)
        <div class="mobile-submenu">
          @each(child in item.children)
            <a href="{{ child.href }}" @click="open = false">{{ child.label }}</a>
          @end
        </div>
      @end
    @end
    @if(auth.user)
      <a href="/admin">Painel administrativo</a>
    @else
      <a href="/login">Entrar no portal</a>
    @end
  </nav>
</header>

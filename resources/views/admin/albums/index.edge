@layout('layouts/main')

@section('body')
<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold">Galerias</h1>
      <p class="text-sm text-gray-600">Álbuns e fotografias do Terreiro.</p>
    </div>
    <a href="/admin/albums/create" class="btn btn-primary">Novo álbum</a>
  </div>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    @each(album in albums)
      <article class="rounded-xl border p-4 bg-white">
        @if(album.coverPath)
          <img src="{{ album.coverPath }}" alt="Capa do álbum {{ album.title }}" class="w-full h-44 object-cover rounded-lg mb-3">
        @endif
        <h2 class="font-semibold text-lg">{{ album.title }}</h2>
        <p class="text-sm text-gray-600">{{ album.$extras.photos_count ?? 0 }} foto(s)</p>
        <div class="mt-4 flex gap-3">
          <a href="/admin/albums/{{ album.id }}/edit" class="text-green-800 underline">Editar</a>
          <form method="POST" action="/admin/albums/{{ album.id }}/delete" onsubmit="return confirm('Excluir este álbum?')">
            {{ csrfField() }}
            <button type="submit" class="text-red-700 underline">Excluir</button>
          </form>
        </div>
      </article>
    @else
      <p>Nenhum álbum cadastrado.</p>
    @end
  </div>
</div>
@endsection

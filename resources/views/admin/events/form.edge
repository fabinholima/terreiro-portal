@layout()
  <header class="admin-page-head">
    <div>
      <h1>{{ event ? 'Editar evento' : 'Novo evento' }}</h1>
      <p>{{ event ? 'Atualize os dados desta atividade.' : 'Cadastre uma nova atividade para a agenda.' }}</p>
    </div>
    <a class="admin-btn" href="/admin/events">← Voltar</a>
  </header>

  <section class="admin-panel" style="max-width:960px">
    <form method="POST" enctype="multipart/form-data" action="{{ event ? '/admin/events/' + event.id : '/admin/events' }}">
      {{ csrfField() }}

      <label>Título
        <input name="title" value="{{ event?.title ?? '' }}" required>
      </label>

      <label>Slug
        <input name="slug" value="{{ event?.slug ?? '' }}" required>
      </label>

      <label>Descrição
        <textarea name="description" rows="5">{{ event?.description ?? '' }}</textarea>
      </label>

      <div class="grid gap-4 md:grid-cols-2">
        <label>Categoria
          <input name="category" value="{{ event?.category ?? '' }}">
        </label>
        <label>Local
          <input name="location" value="{{ event?.location ?? '' }}">
        </label>
      </div>

      <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-bold">Data e horário</h2>
        <p class="mt-1 text-sm text-slate-600">Use sempre o formato de 24 horas, por exemplo 08:30 ou 19:45.</p>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <label>Data de início
            <input type="date" name="startDate" value="{{ event ? event.startsAt.toFormat('yyyy-LL-dd') : '' }}" required>
          </label>
          <label>Hora de início (HH:mm)
            <input type="text" inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" maxlength="5" name="startTime" placeholder="19:30" value="{{ event ? event.startsAt.toFormat('HH:mm') : '' }}" required>
          </label>
          <label>Data de término
            <input type="date" name="endDate" value="{{ event?.endsAt ? event.endsAt.toFormat('yyyy-LL-dd') : '' }}">
          </label>
          <label>Hora de término (HH:mm)
            <input type="text" inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" maxlength="5" name="endTime" placeholder="21:00" value="{{ event?.endsAt ? event.endsAt.toFormat('HH:mm') : '' }}">
          </label>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-bold">Imagem do evento</h2>
        <p class="mt-1 text-sm text-slate-600">JPG, PNG ou WebP. A imagem aparecerá na agenda pública.</p>
        @if(event?.imagePath)
          <img src="{{ event.imagePath }}" alt="Imagem atual do evento" style="max-width:420px;max-height:260px;object-fit:contain" class="mt-4 rounded-lg border border-slate-200 bg-white">
          <p class="mt-2 text-sm text-slate-600">Selecione outra imagem abaixo para substituir a atual.</p>
        @end
        <input class="mt-4" type="file" name="image" accept="image/jpeg,image/png,image/webp">
      </section>

      <label>Status
        <select name="status">
          <option value="scheduled" @if((event?.status ?? 'scheduled') === 'scheduled') selected @end>Agendado</option>
          <option value="confirmed" @if(event?.status === 'confirmed') selected @end>Confirmado</option>
          <option value="postponed" @if(event?.status === 'postponed') selected @end>Adiado</option>
          <option value="cancelled" @if(event?.status === 'cancelled') selected @end>Cancelado</option>
          <option value="completed" @if(event?.status === 'completed') selected @end>Concluído</option>
        </select>
      </label>

      <label style="display:flex;align-items:center;gap:10px">
        <input style="width:auto" type="checkbox" name="isPublic" value="true" @if(event?.isPublic ?? true) checked @end>
        Evento público
      </label>

      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:8px">
        <a class="admin-btn" href="/admin/events">Cancelar</a>
        <button class="admin-btn admin-btn--primary" type="submit">Salvar evento</button>
      </div>
    </form>
  </section>
@end

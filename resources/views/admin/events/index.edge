<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Agenda | Administração</title>
</head>
<body>
  <main>
    <header>
      <h1>Agenda</h1>
      <a href="/admin/events/create">Novo evento</a>
    </header>

    <table>
      <thead>
        <tr><th>Data</th><th>Evento</th><th>Status</th><th>Ações</th></tr>
      </thead>
      <tbody>
        @each(event in events)
          <tr>
            <td>{{ event.startsAt.toFormat('dd/LL/yyyy HH:mm') }}</td>
            <td>{{ event.title }}</td>
            <td>{{ event.status }}</td>
            <td>
              <a href="/admin/events/{{ event.id }}/edit">Editar</a>
              <form method="POST" action="/admin/events/{{ event.id }}/delete" style="display:inline">
                {{ csrfField() }}
                <button type="submit">Excluir</button>
              </form>
            </td>
          </tr>
        @else
          <tr><td colspan="4">Nenhum evento cadastrado.</td></tr>
        @end
      </tbody>
    </table>
  </main>
</body>
</html>

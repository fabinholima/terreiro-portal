@layout()
  <header class="admin-page-head">
    <div>
      <h1>Agenda</h1>
      <p>Gerencie os eventos, giras, reuniões e atividades públicas do Terreiro.</p>
    </div>
    <a class="admin-btn admin-btn--primary" href="/admin/events/create">+ Novo evento</a>
  </header>

  <section class="admin-panel">
    <div style="overflow-x:auto">
      <table>
        <thead>
          <tr><th>Data</th><th>Evento</th><th>Status</th><th>Ações</th></tr>
        </thead>
        <tbody>
          @each(event in events)
            <tr>
              <td>{{ event.startsAt.toFormat('dd/LL/yyyy HH:mm') }}</td>
              <td><strong>{{ event.title }}</strong></td>
              <td>{{ event.status }}</td>
              <td>
                <a class="admin-btn" href="/admin/events/{{ event.id }}/edit">Editar</a>
                <form method="POST" action="/admin/events/{{ event.id }}/delete" style="display:inline" onsubmit="return confirm('Excluir este evento?')">
                  {{ csrfField() }}
                  <button class="admin-btn admin-btn--danger" type="submit">Excluir</button>
                </form>
              </td>
            </tr>
          @else
            <tr><td colspan="4">Nenhum evento cadastrado.</td></tr>
          @end
        </tbody>
      </table>
    </div>
  </section>
@end

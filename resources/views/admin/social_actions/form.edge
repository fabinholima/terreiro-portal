@layout()
  <div class="mx-auto max-w-3xl px-6 py-10">
    <div class="mb-8">
      <p class="text-sm font-medium text-emerald-700">Administração</p>
      <h1 class="text-3xl font-bold text-zinc-900">{{ action ? 'Editar ação social' : 'Nova ação social' }}</h1>
    </div>

    <form method="POST" action="{{ action ? '/admin/social-actions/' + action.id : '/admin/social-actions' }}" class="space-y-6 rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
      {{ csrfField() }}
      <div><label class="mb-2 block font-medium">Título</label><input class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="title" required value="{{ action?.title ?? '' }}"></div>
      <div><label class="mb-2 block font-medium">Slug</label><input class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="slug" required value="{{ action?.slug ?? '' }}"></div>
      <div><label class="mb-2 block font-medium">Descrição</label><textarea class="min-h-36 w-full rounded-lg border border-zinc-300 px-3 py-2" name="description">{{ action?.description ?? '' }}</textarea></div>

      <div class="grid gap-5 md:grid-cols-2">
        <div><label class="mb-2 block font-medium">Status</label><select class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="status">
          @each(status in ['planned','active','completed','permanent','cancelled'])
            <option value="{{ status }}" @if((action?.status ?? 'planned') === status) selected @end>{{ status }}</option>
          @end
        </select></div>
        <div><label class="mb-2 block font-medium">Unidade</label><input class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="unit" placeholder="cestas, kg, peças..." value="{{ action?.unit ?? '' }}"></div>
        <div><label class="mb-2 block font-medium">Meta</label><input type="number" min="0" step="0.01" class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="goal" value="{{ action?.goal ?? '' }}"></div>
        <div><label class="mb-2 block font-medium">Resultado atual</label><input type="number" min="0" step="0.01" class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="currentValue" value="{{ action?.currentValue ?? '' }}"></div>
        <div><label class="mb-2 block font-medium">Início</label><input type="datetime-local" class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="startsAt" value="{{ action?.startsAt ? action.startsAt.toFormat('yyyy-LL-dd\'T\'HH:mm') : '' }}"></div>
        <div><label class="mb-2 block font-medium">Fim</label><input type="datetime-local" class="w-full rounded-lg border border-zinc-300 px-3 py-2" name="endsAt" value="{{ action?.endsAt ? action.endsAt.toFormat('yyyy-LL-dd\'T\'HH:mm') : '' }}"></div>
      </div>

      <label class="flex items-center gap-3"><input type="hidden" name="isPublic" value="false"><input type="checkbox" name="isPublic" value="true" @if(action?.isPublic ?? true) checked @end><span>Publicar no site</span></label>

      <div class="flex gap-3"><button class="rounded-lg bg-emerald-800 px-4 py-2 font-semibold text-white" type="submit">Salvar</button><a class="rounded-lg border border-zinc-300 px-4 py-2" href="/admin/social-actions">Cancelar</a></div>
    </form>
  </div>
@end

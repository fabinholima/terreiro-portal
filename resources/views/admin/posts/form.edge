@layout()
  <div class="mx-auto max-w-4xl px-6 py-10">
    <div class="mb-8">
      <a href="/admin/posts" class="text-sm text-slate-600 underline">← Voltar</a>
      <h1 class="mt-3 text-3xl font-bold">{{ post ? 'Editar notícia' : 'Nova notícia' }}</h1>
    </div>

    <form method="POST" action="{{ post ? '/admin/posts/' + post.id : '/admin/posts' }}" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6">
      {{ csrfField() }}
      <label class="block"><span class="mb-2 block font-semibold">Título</span><input name="title" required maxlength="180" value="{{ post?.title ?? '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      <label class="block"><span class="mb-2 block font-semibold">Slug</span><input name="slug" required maxlength="200" value="{{ post?.slug ?? '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      <label class="block"><span class="mb-2 block font-semibold">Resumo</span><textarea name="summary" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2">{{ post?.summary ?? '' }}</textarea></label>
      <label class="block"><span class="mb-2 block font-semibold">Texto completo</span><textarea name="body" rows="14" class="w-full rounded-lg border border-slate-300 px-3 py-2">{{ post?.body ?? '' }}</textarea></label>

      <div class="grid gap-6 md:grid-cols-2">
        <label class="block">
          <span class="mb-2 block font-semibold">Status</span>
          <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2">
            @each(status in ['draft', 'published', 'archived'])
              <option value="{{ status }}" @if((post?.status ?? 'draft') === status) selected @end>{{ status }}</option>
            @end
          </select>
        </label>
        <label class="block"><span class="mb-2 block font-semibold">Data de publicação</span><input type="datetime-local" name="publishedAt" value="{{ post?.publishedAt ? post.publishedAt.toFormat(`yyyy-LL-dd'T'HH:mm`) : '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      </div>
      <div class="flex justify-end"><button class="rounded-lg bg-emerald-800 px-5 py-2.5 font-semibold text-white">Salvar</button></div>
    </form>
  </div>
@end

@layout()
  <div class="mx-auto max-w-4xl px-6 py-10">
    <div class="mb-8">
      <a href="/admin/posts" class="text-sm text-slate-600 underline">← Voltar</a>
      <h1 class="mt-3 text-3xl font-bold">{{ post ? 'Editar notícia' : 'Nova notícia' }}</h1>
      <p class="mt-2 text-slate-600">Cadastre o texto, a imagem de destaque e as imagens complementares da publicação.</p>
    </div>

    <form method="POST" enctype="multipart/form-data" action="{{ post ? '/admin/posts/' + post.id : '/admin/posts' }}" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6">
      {{ csrfField() }}
      <label class="block"><span class="mb-2 block font-semibold">Título</span><input name="title" required maxlength="180" value="{{ post?.title ?? '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      <label class="block"><span class="mb-2 block font-semibold">Slug</span><input name="slug" required maxlength="200" value="{{ post?.slug ?? '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      <label class="block"><span class="mb-2 block font-semibold">Resumo</span><textarea name="summary" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2">{{ post?.summary ?? '' }}</textarea></label>
      <label class="block"><span class="mb-2 block font-semibold">Texto completo</span><textarea name="body" rows="14" class="w-full rounded-lg border border-slate-300 px-3 py-2">{{ post?.body ?? '' }}</textarea><span class="mt-2 block text-sm text-slate-500">Use parágrafos curtos. As imagens complementares serão exibidas abaixo do texto, com o tamanho definido nesta tela.</span></label>

      <div class="grid gap-6 md:grid-cols-2">
        <label class="block">
          <span class="mb-2 block font-semibold">Imagem de destaque</span>
          <input type="file" name="featuredImage" accept="image/jpeg,image/png,image/webp" class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <span class="mt-2 block text-sm text-slate-500">Recomendado: imagem horizontal, preferencialmente 1600 × 900 px.</span>
          @if(post?.featuredImagePath)
            <img src="{{ post.featuredImagePath }}" alt="Imagem de destaque atual" class="mt-3 h-36 w-full rounded-lg object-cover">
          @end
        </label>

        <label class="block">
          <span class="mb-2 block font-semibold">Fotos e figuras anexas</span>
          <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <span class="mt-2 block text-sm text-slate-500">Selecione uma ou várias imagens para complementar a notícia.</span>
        </label>
      </div>

      <label class="block">
        <span class="mb-2 block font-semibold">Tamanho das imagens no conteúdo</span>
        <select name="imageDisplaySize" class="w-full rounded-lg border border-slate-300 px-3 py-2">
          <option value="small" @if((post?.imageDisplaySize ?? 'large') === 'small') selected @end>Pequena — até 420 px</option>
          <option value="medium" @if((post?.imageDisplaySize ?? 'large') === 'medium') selected @end>Média — até 640 px</option>
          <option value="large" @if((post?.imageDisplaySize ?? 'large') === 'large') selected @end>Grande — até 900 px</option>
          <option value="full" @if((post?.imageDisplaySize ?? 'large') === 'full') selected @end>Largura total do artigo</option>
        </select>
        <span class="mt-2 block text-sm text-slate-500">No celular, as imagens sempre se ajustam automaticamente à largura disponível.</span>
      </label>

      @if(post?.imagePaths && post.imagePaths.length)
        <div>
          <p class="mb-3 font-semibold">Imagens já anexadas</p>
          <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
            @each(image in post.imagePaths)
              <img src="{{ image }}" alt="Imagem anexa da notícia" class="h-28 w-full rounded-lg object-cover">
            @end
          </div>
        </div>
      @end

      <div class="grid gap-6 md:grid-cols-2">
        <label class="block">
          <span class="mb-2 block font-semibold">Status</span>
          <select name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2">
            @each(status in ['draft', 'published', 'archived'])
              <option value="{{ status }}" @if((post?.status ?? 'draft') === status) selected @end>{{ status }}</option>
            @end
          </select>
        </label>
        <label class="block"><span class="mb-2 block font-semibold">Data de publicação</span><input type="datetime-local" name="publishedAt" value="{{ post?.publishedAt ? post.publishedAt.toFormat(`yyyy-LL-dd'T'HH:mm`) : '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      </div>
      <div class="flex justify-end"><button class="rounded-lg bg-emerald-800 px-5 py-2.5 font-semibold text-white">Salvar</button></div>
    </form>
  </div>
@end

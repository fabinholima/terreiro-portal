@layout()
  <div class="mx-auto max-w-5xl px-6 py-10">
    <div class="mb-8">
      <a href="/admin/posts" class="text-sm text-slate-600 underline">← Voltar</a>
      <h1 class="mt-3 text-3xl font-bold">{{ post ? 'Editar notícia' : 'Nova notícia' }}</h1>
      <p class="mt-2 text-slate-600">Cadastre o conteúdo, formate o texto e controle individualmente as imagens da publicação.</p>
    </div>

    <form id="post-form" method="POST" enctype="multipart/form-data" action="{{ post ? '/admin/posts/' + post.id : '/admin/posts' }}" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6">
      {{ csrfField() }}

      <label class="block"><span class="mb-2 block font-semibold">Título</span><input name="title" required maxlength="180" value="{{ post?.title ?? '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      <label class="block"><span class="mb-2 block font-semibold">Slug</span><input name="slug" required maxlength="200" value="{{ post?.slug ?? '' }}" class="w-full rounded-lg border border-slate-300 px-3 py-2"></label>
      <label class="block"><span class="mb-2 block font-semibold">Resumo</span><textarea name="summary" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2">{{ post?.summary ?? '' }}</textarea></label>

      <div class="block">
        <span class="mb-2 block font-semibold">Texto completo</span>
        <div class="rich-editor" data-rich-editor>
          <div class="rich-editor__toolbar" role="toolbar" aria-label="Formatação do texto">
            <button type="button" data-command="bold" title="Negrito"><strong>B</strong></button>
            <button type="button" data-command="italic" title="Itálico"><em>I</em></button>
            <button type="button" data-command="underline" title="Sublinhado"><u>U</u></button>
            <span class="rich-editor__separator"></span>
            <button type="button" data-command="formatBlock" data-value="p">Parágrafo</button>
            <button type="button" data-command="formatBlock" data-value="h2">Título 2</button>
            <button type="button" data-command="formatBlock" data-value="h3">Título 3</button>
            <span class="rich-editor__separator"></span>
            <button type="button" data-command="insertUnorderedList" title="Lista com marcadores">• Lista</button>
            <button type="button" data-command="insertOrderedList" title="Lista numerada">1. Lista</button>
            <button type="button" data-command="formatBlock" data-value="blockquote">Citação</button>
            <button type="button" data-link>Link</button>
            <button type="button" data-editor-image title="Inserir imagem no ponto atual">Imagem</button>
            <button type="button" data-command="removeFormat">Limpar</button>
          </div>
          <div class="rich-editor__surface" contenteditable="true" data-editor-surface aria-label="Editor de texto completo"></div>
          <textarea name="body" data-editor-input hidden>{{ post?.body ?? '' }}</textarea>
          <input type="file" accept="image/jpeg,image/png,image/webp" data-editor-image-input hidden>
        </div>
        <span class="mt-2 block text-sm text-slate-500">Além da formatação, o botão <strong>Imagem</strong> envia uma figura e a insere exatamente na posição atual do texto.</span>
      </div>

      <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-bold">Imagem de destaque</h2>
        <p class="mt-1 text-sm text-slate-600">As dimensões abaixo são gravadas no banco e aplicadas à apresentação da notícia.</p>

        @if(!post?.featuredImagePath)
          <label class="mt-4 block">
            <span class="mb-2 block font-semibold">Selecionar imagem</span>
            <input type="file" name="featuredImage" accept="image/jpeg,image/png,image/webp" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2">
          </label>
        @end

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <label class="block"><span class="mb-2 block font-semibold">Largura (px)</span><input type="number" min="100" max="3000" step="1" name="featuredImageWidth" placeholder="Ex.: 900" value="{{ post?.featuredImageWidth ?? '' }}" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></label>
          <label class="block"><span class="mb-2 block font-semibold">Altura (px)</span><input type="number" min="100" max="3000" step="1" name="featuredImageHeight" placeholder="Ex.: 500" value="{{ post?.featuredImageHeight ?? '' }}" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></label>
          <label class="block"><span class="mb-2 block font-semibold">Ajuste</span><select name="featuredImageFit" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"><option value="contain" @if((post?.featuredImageFit ?? 'contain') === 'contain') selected @end>Conter — sem cortar</option><option value="cover" @if(post?.featuredImageFit === 'cover') selected @end>Preencher — pode cortar</option></select></label>
        </div>
      </section>

      <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-bold">Fotos e figuras no conteúdo</h2>
        <label class="mt-4 block"><span class="mb-2 block font-semibold">Adicionar novas imagens</span><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></label>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <label class="block"><span class="mb-2 block font-semibold">Largura padrão para novas imagens (px)</span><input type="number" min="100" max="3000" step="1" name="contentImageWidth" placeholder="Ex.: 640" value="{{ post?.contentImageWidth ?? '' }}" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></label>
          <label class="block"><span class="mb-2 block font-semibold">Altura padrão para novas imagens (px)</span><input type="number" min="100" max="3000" step="1" name="contentImageHeight" placeholder="Opcional" value="{{ post?.contentImageHeight ?? '' }}" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></label>
        </div>
        <label class="mt-4 block"><span class="mb-2 block font-semibold">Tamanho padrão quando não houver dimensão</span><select name="imageDisplaySize" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"><option value="small" @if((post?.imageDisplaySize ?? 'large') === 'small') selected @end>Pequena — até 420 px</option><option value="medium" @if((post?.imageDisplaySize ?? 'large') === 'medium') selected @end>Média — até 640 px</option><option value="large" @if((post?.imageDisplaySize ?? 'large') === 'large') selected @end>Grande — até 900 px</option><option value="full" @if((post?.imageDisplaySize ?? 'large') === 'full') selected @end>Largura total do artigo</option></select></label>
      </section>

      <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-bold">Publicação</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          <label class="block">
            <span class="mb-2 block font-semibold">Status</span>
            <select name="status" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2">
              <option value="draft" @if((post?.status ?? 'draft') === 'draft') selected @end>Rascunho</option>
              <option value="published" @if(post?.status === 'published') selected @end>Publicado</option>
              <option value="archived" @if(post?.status === 'archived') selected @end>Arquivado</option>
            </select>
            <span class="mt-1 block text-xs text-slate-500">Rascunho não aparece no site; Publicado fica visível; Arquivado permanece salvo, mas fora da área pública.</span>
          </label>
          <label class="block"><span class="mb-2 block font-semibold">Data</span><input type="date" name="publishedDate" value="{{ post?.publishedAt ? post.publishedAt.toFormat('yyyy-LL-dd') : '' }}" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></label>
          <label class="block"><span class="mb-2 block font-semibold">Hora (24 horas)</span><input type="text" inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" maxlength="5" name="publishedTime" placeholder="19:30" value="{{ post?.publishedAt ? post.publishedAt.toFormat('HH:mm') : '' }}" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"><span class="mt-1 block text-xs text-slate-500">Formato HH:mm, por exemplo 08:30 ou 19:45.</span></label>
        </div>
      </section>

      <div class="flex justify-end"><button class="admin-action-btn admin-action-btn--save" type="submit"><span aria-hidden="true">✓</span> Salvar notícia</button></div>
    </form>

    @if(post?.featuredImagePath)
      <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-bold">Imagem de destaque atual</h2>
        <p class="text-sm text-slate-600">Dimensão gravada: {{ post.featuredImageWidth ?? 'automática' }} × {{ post.featuredImageHeight ?? 'automática' }} px.</p>
        <img src="{{ post.featuredImagePath }}" alt="Imagem de destaque atual" style="max-width:520px;max-height:300px;object-fit:contain" class="mt-4 rounded-lg border border-slate-200">
        <div class="mt-4 flex flex-wrap gap-3">
          <form method="POST" enctype="multipart/form-data" action="/admin/posts/{{ post.id }}/featured-image/replace" class="flex flex-wrap items-center gap-2">{{ csrfField() }}<input type="file" name="featuredImage" accept="image/jpeg,image/png,image/webp" required class="rounded-lg border border-slate-300 px-3 py-2"><button type="submit" class="admin-action-btn admin-action-btn--edit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>Substituir</button></form>
          <form method="POST" action="/admin/posts/{{ post.id }}/featured-image/delete" onsubmit="return confirm('Excluir a imagem de destaque?')">{{ csrfField() }}<button type="submit" class="admin-action-btn admin-action-btn--delete"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>Excluir</button></form>
        </div>
      </section>
    @end

    @if(post?.imagePaths && post.imagePaths.length)
      <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-bold">Imagens anexadas</h2>
        <p class="mt-1 text-sm text-slate-600">Edite o tamanho de cada figura individualmente; esses valores ficam gravados no banco.</p>
        <div class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          @each((image, index) in post.imagePaths)
            <article class="rounded-xl border border-slate-200 p-4">
              <img src="{{ image }}" alt="Imagem anexa da notícia" style="width:100%;height:180px;object-fit:contain" class="rounded-lg bg-slate-50">
              <form method="POST" action="/admin/posts/{{ post.id }}/images/{{ index }}/dimensions" class="mt-3 space-y-2">
                {{ csrfField() }}
                <div class="grid grid-cols-2 gap-2">
                  <label><span class="mb-1 block text-xs font-semibold">Largura px</span><input type="number" name="width" min="100" max="3000" value="{{ post.imageSettings && post.imageSettings[image] ? (post.imageSettings[image].width ?? '') : '' }}" class="w-full rounded-lg border border-slate-300 px-2 py-2"></label>
                  <label><span class="mb-1 block text-xs font-semibold">Altura px</span><input type="number" name="height" min="100" max="3000" value="{{ post.imageSettings && post.imageSettings[image] ? (post.imageSettings[image].height ?? '') : '' }}" class="w-full rounded-lg border border-slate-300 px-2 py-2"></label>
                </div>
                <button type="submit" class="admin-action-btn admin-action-btn--neutral"><span aria-hidden="true">↕</span>Salvar tamanho</button>
              </form>
              <form method="POST" enctype="multipart/form-data" action="/admin/posts/{{ post.id }}/images/{{ index }}/replace" class="mt-3 space-y-2">{{ csrfField() }}<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required class="w-full rounded-lg border border-slate-300 px-2 py-2 text-sm"><button type="submit" class="admin-action-btn admin-action-btn--edit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>Substituir</button></form>
              <form method="POST" action="/admin/posts/{{ post.id }}/images/{{ index }}/delete" class="mt-2" onsubmit="return confirm('Excluir esta imagem?')">{{ csrfField() }}<button type="submit" class="admin-action-btn admin-action-btn--delete"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>Excluir</button></form>
            </article>
          @end
        </div>
      </section>
    @end
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const root = document.querySelector('[data-rich-editor]')
      if (!root) return
      const surface = root.querySelector('[data-editor-surface]')
      const input = root.querySelector('[data-editor-input]')
      const imageInput = root.querySelector('[data-editor-image-input]')
      const imageButton = root.querySelector('[data-editor-image]')
      const form = document.querySelector('#post-form')
      if (!surface || !input || !form) return

      const initial = input.value || ''
      const looksLikeHtml = /<\/?[a-z][\s\S]*>/i.test(initial)
      surface.innerHTML = looksLikeHtml
        ? initial
        : initial.split(/\n{2,}/).filter(Boolean).map((p) => `<p>${p.replace(/\n/g, '<br>')}</p>`).join('')

      root.querySelectorAll('[data-command]').forEach((button) => {
        button.addEventListener('click', () => {
          surface.focus()
          document.execCommand(button.dataset.command, false, button.dataset.value || null)
        })
      })

      const linkButton = root.querySelector('[data-link]')
      if (linkButton) {
        linkButton.addEventListener('click', () => {
          const url = window.prompt('Digite o endereço do link (https://...)')
          if (!url) return
          surface.focus()
          document.execCommand('createLink', false, url)
        })
      }

      if (imageButton && imageInput) {
        imageButton.addEventListener('click', () => imageInput.click())
        imageInput.addEventListener('change', async () => {
          const file = imageInput.files && imageInput.files[0]
          if (!file) return

          const csrf = form.querySelector('input[name="_csrf"]')
          const data = new FormData()
          data.append('image', file)
          if (csrf) data.append('_csrf', csrf.value)

          imageButton.disabled = true
          imageButton.textContent = 'Enviando...'

          try {
            const response = await fetch('/admin/posts/editor-image-upload', {
              method: 'POST',
              body: data,
              headers: { Accept: 'application/json' },
            })
            if (!response.ok) throw new Error('Falha no upload')
            const result = await response.json()
            const width = window.prompt('Largura da imagem em pixels (deixe vazio para automática):', '700')
            const widthStyle = width && /^\d+$/.test(width) ? `max-width:${Math.min(3000, Math.max(100, Number(width)))}px;` : 'max-width:100%;'
            surface.focus()
            document.execCommand('insertHTML', false, `<figure class="article-inline-image" style="text-align:center;margin:1.5rem auto;"><img src="${result.path}" alt="" style="${widthStyle}width:100%;height:auto;display:inline-block;"></figure><p><br></p>`)
          } catch (error) {
            window.alert('Não foi possível inserir a imagem no editor.')
          } finally {
            imageButton.disabled = false
            imageButton.textContent = 'Imagem'
            imageInput.value = ''
          }
        })
      }

      form.addEventListener('submit', () => {
        input.value = surface.innerHTML.trim()
      })
    })
  </script>
@end

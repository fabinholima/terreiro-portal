@layout()
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="mb-8 flex items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold">Notícias</h1>
        <p class="mt-2 text-slate-600">Gerencie rascunhos, publicações e conteúdos arquivados.</p>
      </div>
      <a href="/admin/posts/create" class="admin-action-btn admin-action-btn--save"><span aria-hidden="true">＋</span>Nova notícia</a>
    </div>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
      <table class="w-full text-left">
        <thead class="bg-slate-50 text-sm text-slate-600">
          <tr><th class="px-4 py-3">Título</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Publicação</th><th class="px-4 py-3">Ações</th></tr>
        </thead>
        <tbody>
          @each(post in posts)
            <tr class="border-t border-slate-100">
              <td class="px-4 py-3 font-medium">{{ post.title }}</td>
              <td class="px-4 py-3">
                @if(post.status === 'published')
                  <span class="admin-status admin-status--published">Publicado</span>
                @elseif(post.status === 'archived')
                  <span class="admin-status admin-status--archived">Arquivado</span>
                @else
                  <span class="admin-status admin-status--draft">Rascunho</span>
                @end
              </td>
              <td class="px-4 py-3">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy · HH:mm') : 'Não publicado' }}</td>
              <td class="px-4 py-3">
                <div class="admin-actions">
                  <a href="/admin/posts/{{ post.id }}/edit" class="admin-action-btn admin-action-btn--edit" title="Editar notícia">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
                    <span>Editar</span>
                  </a>
                  <form method="POST" action="/admin/posts/{{ post.id }}/delete" class="inline" onsubmit="return confirm('Excluir esta notícia?')">
                    {{ csrfField() }}
                    <button type="submit" class="admin-action-btn admin-action-btn--delete" title="Excluir notícia">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>
                      <span>Excluir</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          @else
            <tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">Nenhuma notícia cadastrada.</td></tr>
          @end
        </tbody>
      </table>
    </div>
  </div>
@end

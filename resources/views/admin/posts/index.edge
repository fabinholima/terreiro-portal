@layout()
  <style>
    .admin-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.admin-actions form{display:inline-flex!important;margin:0}.admin-action-btn{display:inline-flex!important;align-items:center;justify-content:center;gap:7px;width:auto!important;min-height:36px;padding:8px 12px!important;border-radius:8px!important;border:1px solid #d8e1da!important;font-size:.82rem!important;font-weight:750!important;line-height:1!important;text-decoration:none!important;box-shadow:0 1px 2px rgba(20,50,30,.04);transition:.18s ease}.admin-action-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.admin-action-btn--edit{background:#eef6f1!important;color:#165c36!important;border-color:#cfe0d5!important}.admin-action-btn--edit:hover{background:#dfeee4!important}.admin-action-btn--delete{background:#fff2f0!important;color:#a93226!important;border-color:#f0d0cb!important}.admin-action-btn--delete:hover{background:#fbe4e0!important}.admin-action-btn--save{background:#123f29!important;color:#fff!important;border-color:#123f29!important}.admin-status{display:inline-flex;align-items:center;border-radius:999px;padding:5px 9px;font-size:.72rem;font-weight:800;letter-spacing:.02em}.admin-status--published{background:#e8f5ec;color:#17643b}.admin-status--draft{background:#fff5d9;color:#8a6512}.admin-status--archived{background:#eef0f2;color:#5f6870}
  </style>
  <div class="mx-auto max-w-6xl px-6 py-10">
    <div class="mb-8 flex items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold">Notícias</h1>
        <p class="mt-2 text-slate-600">Gerencie rascunhos, publicações e conteúdos arquivados.</p>
      </div>
      <a href="/admin/posts/create" class="admin-action-btn admin-action-btn--save"><span aria-hidden="true">＋</span>Nova notícia</a>
    </div>

    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
      <table class="w-full text-left">
        <thead class="bg-slate-50 text-sm text-slate-600">
          <tr><th class="px-4 py-3">Título</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Publicação</th><th class="px-4 py-3">Ações</th></tr>
        </thead>
        <tbody>
          @each(post in posts)
            <tr class="border-t border-slate-100">
              <td class="px-4 py-3 font-medium">{{ post.title }}</td>
              <td class="px-4 py-3">
                @if(post.status === 'published')
                  <span class="admin-status admin-status--published">Publicado</span>
                @elseif(post.status === 'archived')
                  <span class="admin-status admin-status--archived">Arquivado</span>
                @else
                  <span class="admin-status admin-status--draft">Rascunho</span>
                @end
              </td>
              <td class="px-4 py-3">{{ post.publishedAt ? post.publishedAt.toFormat('dd/LL/yyyy · HH:mm') : 'Não publicado' }}</td>
              <td class="px-4 py-3">
                <div class="admin-actions">
                  <a href="/admin/posts/{{ post.id }}/edit" class="admin-action-btn admin-action-btn--edit" title="Editar notícia">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
                    <span>Editar</span>
                  </a>
                  <form method="POST" action="/admin/posts/{{ post.id }}/delete" class="inline" onsubmit="return confirm('Excluir esta notícia?')">
                    {{ csrfField() }}
                    <button type="submit" class="admin-action-btn admin-action-btn--delete" title="Excluir notícia">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v5M14 11v5"/></svg>
                      <span>Excluir</span>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          @else
            <tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">Nenhuma notícia cadastrada.</td></tr>
          @end
        </tbody>
      </table>
    </div>
  </div>
@end

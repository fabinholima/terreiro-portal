@layout()
  <section class="mx-auto max-w-4xl px-6 py-10">
    <div class="mb-8">
      <a href="/admin/institutional-pages" class="text-sm font-semibold text-emerald-800 underline">← Páginas institucionais</a>
      <h1 class="mt-4 text-3xl font-bold">Editar {{ page.title }}</h1>
      <p class="mt-2 text-slate-600">URL fixa: /{{ page.slug }}</p>
    </div>

    <form method="POST" action="/admin/institutional-pages/{{ page.id }}" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6" onsubmit="syncInstitutionalEditor()">
      {{ csrfField() }}

      <label class="block">
        <span class="mb-2 block font-semibold">Título</span>
        <input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="title" required maxlength="180" value="{{ page.title }}">
      </label>

      <label class="block">
        <span class="mb-2 block font-semibold">Chamada superior</span>
        <input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="eyebrow" maxlength="120" value="{{ page.eyebrow ?? '' }}">
      </label>

      <label class="block">
        <span class="mb-2 block font-semibold">Resumo</span>
        <textarea class="min-h-28 w-full rounded-lg border border-slate-300 px-3 py-2" name="summary">{{ page.summary ?? '' }}</textarea>
      </label>

      <div class="block">
        <span class="mb-2 block font-semibold">Texto completo</span>

        <div class="institutional-editor">
          <div class="institutional-editor__toolbar" role="toolbar" aria-label="Formatação do texto">
            <button type="button" onclick="institutionalCommand('bold')" title="Negrito"><strong>B</strong></button>
            <button type="button" onclick="institutionalCommand('italic')" title="Itálico"><em>I</em></button>
            <button type="button" onclick="institutionalCommand('underline')" title="Sublinhado"><u>U</u></button>
            <span class="institutional-editor__separator"></span>
            <button type="button" onclick="institutionalBlock('p')" title="Parágrafo">P</button>
            <button type="button" onclick="institutionalBlock('h2')" title="Título 2">H2</button>
            <button type="button" onclick="institutionalBlock('h3')" title="Título 3">H3</button>
            <span class="institutional-editor__separator"></span>
            <button type="button" onclick="institutionalCommand('insertUnorderedList')" title="Lista com marcadores">• Lista</button>
            <button type="button" onclick="institutionalCommand('insertOrderedList')" title="Lista numerada">1. Lista</button>
            <button type="button" onclick="institutionalBlock('blockquote')" title="Citação">❝</button>
            <span class="institutional-editor__separator"></span>
            <button type="button" onclick="institutionalCreateLink()" title="Inserir link">🔗</button>
            <button type="button" onclick="institutionalCommand('removeFormat')" title="Remover formatação">Tx</button>
          </div>

          <div id="institutional-rich-editor" class="institutional-editor__content" contenteditable="true">{{{ page.body }}}</div>
        </div>

        <textarea id="institutional-body" class="hidden" name="body" required>{{ page.body }}</textarea>
        <span class="mt-2 block text-sm text-slate-500">Use a barra acima para formatar títulos, listas, links, negrito, itálico e citações.</span>
      </div>

      <label class="flex items-center gap-3">
        <input type="checkbox" name="isPublic" value="true" @if(page.isPublic) checked @end>
        <span>Disponível publicamente</span>
      </label>

      <div class="flex flex-wrap gap-3">
        <button class="rounded-lg bg-emerald-800 px-5 py-2.5 font-semibold text-white" type="submit">Salvar alterações</button>
        <a class="rounded-lg border border-slate-300 px-5 py-2.5" href="/{{ page.slug }}" target="_blank">Visualizar página</a>
      </div>
    </form>
  </section>

  <style>
    .institutional-editor{overflow:hidden;border:1px solid #cbd5e1;border-radius:12px;background:#fff}.institutional-editor:focus-within{border-color:#2f6b45;box-shadow:0 0 0 3px rgba(47,107,69,.09)}.institutional-editor__toolbar{display:flex;flex-wrap:wrap;gap:5px;align-items:center;padding:9px;border-bottom:1px solid #e2e8f0;background:#f8fafc}.institutional-editor__toolbar button{min-width:34px;height:34px;padding:0 9px;border:1px solid #d6dde5;border-radius:7px;background:#fff;color:#334155;font-size:.82rem;cursor:pointer}.institutional-editor__toolbar button:hover{border-color:#9bb7a5;background:#eef5f0;color:#174b2c}.institutional-editor__separator{width:1px;height:25px;background:#dbe1e7;margin:0 3px}.institutional-editor__content{min-height:330px;padding:18px;color:#334155;line-height:1.75;outline:none}.institutional-editor__content h2{margin:1.4em 0 .55em;font-size:1.6rem;color:#16482b}.institutional-editor__content h3{margin:1.25em 0 .5em;font-size:1.25rem;color:#245c39}.institutional-editor__content p{margin:.75em 0}.institutional-editor__content ul,.institutional-editor__content ol{padding-left:1.7rem;margin:.8em 0}.institutional-editor__content blockquote{margin:1em 0;padding:.7em 1em;border-left:3px solid #c89d45;background:#faf7ef;color:#566159}.institutional-editor__content a{color:#17633a;text-decoration:underline}
  </style>

  <script>
    function institutionalEditor() {
      return document.getElementById('institutional-rich-editor')
    }

    function institutionalCommand(command) {
      institutionalEditor().focus()
      document.execCommand(command, false, null)
    }

    function institutionalBlock(tag) {
      institutionalEditor().focus()
      document.execCommand('formatBlock', false, tag)
    }

    function institutionalCreateLink() {
      const url = window.prompt('Informe o endereço do link (https://...)')
      if (!url) return
      institutionalEditor().focus()
      document.execCommand('createLink', false, url)
    }

    function syncInstitutionalEditor() {
      document.getElementById('institutional-body').value = institutionalEditor().innerHTML
    }
  </script>
@end

@layout()
  <section class="mx-auto max-w-4xl px-6 py-10">
    <div class="mb-8">
      <a href="/admin/institutional-pages" class="text-sm font-semibold text-emerald-800 underline">← Páginas</a>
      <h1 class="mt-4 text-3xl font-bold">Nova página</h1>
      <p class="mt-2 text-slate-600">Crie o conteúdo da página. Depois você poderá decidir onde ela aparece no menu.</p>
    </div>

    <form method="POST" action="/admin/institutional-pages" class="space-y-6 rounded-xl border border-slate-200 bg-white p-6" onsubmit="syncInstitutionalEditor()">
      {{ csrfField() }}

      <label class="block">
        <span class="mb-2 block font-semibold">Título da página</span>
        <input id="page-title" name="title" required maxlength="180" placeholder="Ex.: Nossa missão" oninput="suggestSlug(this.value)">
      </label>

      <label class="block">
        <span class="mb-2 block font-semibold">Endereço da página</span>
        <div class="flex items-center gap-2">
          <span class="rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-500">/pagina/</span>
          <input id="page-slug" name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="nossa-missao">
        </div>
        <span class="mt-1 block text-sm text-slate-500">Gerado automaticamente a partir do título. Você pode alterá-lo antes de salvar.</span>
      </label>

      <label class="block">
        <span class="mb-2 block font-semibold">Chamada superior <small class="font-normal text-slate-500">(opcional)</small></span>
        <input name="eyebrow" maxlength="120" placeholder="Ex.: Institucional">
      </label>

      <label class="block">
        <span class="mb-2 block font-semibold">Resumo <small class="font-normal text-slate-500">(opcional)</small></span>
        <textarea class="min-h-28" name="summary" placeholder="Uma apresentação curta da página."></textarea>
      </label>

      <div>
        <span class="mb-2 block font-semibold">Texto completo</span>
        <div class="institutional-editor">
          <div class="institutional-editor__toolbar" role="toolbar" aria-label="Formatação do texto">
            <button type="button" onclick="institutionalCommand('bold')" title="Negrito"><strong>B</strong></button>
            <button type="button" onclick="institutionalCommand('italic')" title="Itálico"><em>I</em></button>
            <button type="button" onclick="institutionalCommand('underline')" title="Sublinhado"><u>U</u></button>
            <span class="institutional-editor__separator"></span>
            <button type="button" onclick="institutionalBlock('p')">P</button>
            <button type="button" onclick="institutionalBlock('h2')">H2</button>
            <button type="button" onclick="institutionalBlock('h3')">H3</button>
            <span class="institutional-editor__separator"></span>
            <button type="button" onclick="institutionalCommand('insertUnorderedList')">• Lista</button>
            <button type="button" onclick="institutionalCommand('insertOrderedList')">1. Lista</button>
            <button type="button" onclick="institutionalBlock('blockquote')">❝</button>
            <span class="institutional-editor__separator"></span>
            <button type="button" onclick="institutionalCreateLink()">🔗</button>
            <button type="button" onclick="institutionalCommand('removeFormat')">Tx</button>
          </div>
          <div id="institutional-rich-editor" class="institutional-editor__content" contenteditable="true"><p>Digite o conteúdo da página.</p></div>
        </div>
        <textarea id="institutional-body" class="hidden" name="body" required>Digite o conteúdo da página.</textarea>
      </div>

      <label class="flex items-center gap-3">
        <input class="w-auto" type="checkbox" name="isPublic" value="true" checked>
        <span>Publicar a página imediatamente</span>
      </label>

      <div class="rounded-xl bg-emerald-50 p-4 text-sm text-emerald-900">
        Após criar a página, use <strong>Menu do site</strong> para colocá-la no menu principal ou dentro de um submenu.
      </div>

      <div class="flex flex-wrap gap-3">
        <button class="rounded-lg bg-emerald-800 px-5 py-2.5 font-semibold text-white" type="submit">Criar página</button>
        <a class="rounded-lg border border-slate-300 px-5 py-2.5" href="/admin/institutional-pages">Cancelar</a>
      </div>
    </form>
  </section>

  <style>
    .institutional-editor{overflow:hidden;border:1px solid #cbd5e1;border-radius:12px;background:#fff}.institutional-editor:focus-within{border-color:#2f6b45;box-shadow:0 0 0 3px rgba(47,107,69,.09)}.institutional-editor__toolbar{display:flex;flex-wrap:wrap;gap:5px;align-items:center;padding:9px;border-bottom:1px solid #e2e8f0;background:#f8fafc}.institutional-editor__toolbar button{min-width:34px;height:34px;padding:0 9px;border:1px solid #d6dde5;border-radius:7px;background:#fff;color:#334155;cursor:pointer}.institutional-editor__toolbar button:hover{border-color:#9bb7a5;background:#eef5f0;color:#174b2c}.institutional-editor__separator{width:1px;height:25px;background:#dbe1e7}.institutional-editor__content{min-height:330px;padding:18px;color:#334155;line-height:1.75;outline:none}.institutional-editor__content h2{font-size:1.6rem}.institutional-editor__content h3{font-size:1.25rem}.institutional-editor__content blockquote{padding:.7em 1em;border-left:3px solid #c89d45;background:#faf7ef}
  </style>

  <script>
    function institutionalEditor(){ return document.getElementById('institutional-rich-editor') }
    function institutionalCommand(command){ institutionalEditor().focus(); document.execCommand(command,false,null) }
    function institutionalBlock(tag){ institutionalEditor().focus(); document.execCommand('formatBlock',false,tag) }
    function institutionalCreateLink(){ const url=window.prompt('Informe o endereço do link'); if(url){ institutionalEditor().focus(); document.execCommand('createLink',false,url) } }
    function syncInstitutionalEditor(){ document.getElementById('institutional-body').value=institutionalEditor().innerHTML }
    function suggestSlug(value){
      const slug=document.getElementById('page-slug')
      if(!slug || slug.dataset.edited==='true') return
      slug.value=value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')
    }
    document.addEventListener('DOMContentLoaded',()=>{
      const slug=document.getElementById('page-slug')
      if(slug) slug.addEventListener('input',()=>{ slug.dataset.edited='true' })
    })
  </script>
@end

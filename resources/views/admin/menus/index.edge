@layout()
  <section class="mx-auto max-w-6xl px-6 py-10">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Conteúdo</p>
        <h1 class="mt-2 text-3xl font-bold">Menu do site</h1>
        <p class="mt-2 max-w-2xl text-slate-600">Escolha o que aparece no menu principal e quais itens ficam dentro de um submenu.</p>
      </div>
      <a href="/admin/institutional-pages" class="admin-action admin-action--view">← Páginas</a>
    </div>

    <div class="mb-7 grid gap-4 md:grid-cols-3">
      <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4"><strong class="block text-emerald-900">1. Crie a página</strong><span class="mt-1 block text-sm text-emerald-800">Use Páginas para criar o conteúdo.</span></div>
      <div class="rounded-xl border border-amber-200 bg-amber-50 p-4"><strong class="block text-amber-900">2. Adicione ao menu</strong><span class="mt-1 block text-sm text-amber-800">Escolha a página ou uma rota existente.</span></div>
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-4"><strong class="block text-slate-800">3. Escolha a posição</strong><span class="mt-1 block text-sm text-slate-600">Item principal ou submenu de outro item.</span></div>
    </div>

    <div class="grid gap-7 lg:grid-cols-[390px_1fr]">
      <aside class="self-start rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-5">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">Novo item</p>
          <h2 class="mt-1 text-xl font-bold">Adicionar ao menu</h2>
        </div>

        <form method="POST" action="/admin/menus/items" class="space-y-5">
          {{ csrfField() }}

          <label class="block">
            <span class="mb-1 block font-semibold">Nome que aparecerá no menu</span>
            <input name="label" required placeholder="Ex.: Institucional">
          </label>

          <div class="rounded-xl border border-slate-200 p-4">
            <span class="mb-3 block font-semibold">Para onde este item leva?</span>
            <label class="block">
              <select name="type" onchange="toggleMenuTarget(this.form)">
                <option value="page">Uma página criada no portal</option>
                <option value="url">Uma seção existente ou link externo</option>
              </select>
            </label>

            <label data-page-target class="mt-3 block">
              <span class="mb-1 block text-sm font-semibold text-slate-600">Escolha a página</span>
              <select name="pageId">
                <option value="">Selecione uma página</option>
                @each(pageOption in pages)
                  @if(pageOption)
                    <option value="{{ pageOption.id }}">{{ pageOption.title }}</option>
                  @end
                @end
              </select>
            </label>

            <label data-url-target class="mt-3 hidden">
              <span class="mb-1 block text-sm font-semibold text-slate-600">Endereço</span>
              <input name="url" placeholder="/agenda ou https://exemplo.com">
              <span class="mt-1 block text-xs text-slate-500">Exemplos internos: /agenda, /galeria, /noticias, /documentos.</span>
            </label>
          </div>

          <div class="rounded-xl border border-slate-200 p-4">
            <span class="mb-3 block font-semibold">Onde ele deve aparecer?</span>
            <label class="block">
              <select name="parentId">
                <option value="">No menu principal</option>
                @each(rootOption in roots)
                  @if(rootOption)
                    <option value="{{ rootOption.id }}">Dentro de “{{ rootOption.label }}”</option>
                  @end
                @end
              </select>
            </label>
          </div>

          <div class="grid grid-cols-[110px_1fr] gap-4 items-end">
            <label><span class="mb-1 block text-sm font-semibold">Ordem</span><input type="number" name="position" value="10" min="0"></label>
            <label class="flex items-center gap-2 pb-2"><input class="w-auto" type="checkbox" name="isVisible" value="true" checked> Mostrar no site</label>
          </div>

          <label class="flex items-center gap-2 text-sm text-slate-600"><input class="w-auto" type="checkbox" name="openNewTab" value="true"> Abrir em nova aba</label>
          <button class="w-full rounded-lg bg-emerald-800 px-4 py-3 font-semibold text-white">Adicionar ao menu</button>
        </form>
      </aside>

      <div>
        <div class="mb-4 rounded-2xl border border-slate-200 bg-white p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div><p class="text-xs font-bold uppercase tracking-widest text-slate-500">Visualização</p><h2 class="mt-1 text-xl font-bold">Estrutura atual</h2></div>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">Itens recuados = submenu</span>
          </div>
        </div>

        <div class="space-y-4">
          @each(item in items)
            @if(item)
              <article class="rounded-xl border bg-white p-4 shadow-sm {{ item.parentId ? 'ml-8 border-amber-200' : 'border-slate-200' }}">
                <div class="mb-3 flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    @if(item.parentId)
                      <span class="grid h-8 w-8 place-items-center rounded-full bg-amber-100 text-amber-800">↳</span>
                    @else
                      <span class="grid h-8 w-8 place-items-center rounded-full bg-emerald-100 text-emerald-800">≡</span>
                    @end
                    <div>
                      <strong class="block">{{ item.label }}</strong>
                      @if(item.parentId)
                        <span class="text-xs text-slate-500">Submenu</span>
                      @else
                        <span class="text-xs text-slate-500">Item principal</span>
                      @end
                    </div>
                  </div>
                  @if(item.isVisible)
                    <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Visível</span>
                  @else
                    <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-500">Oculto</span>
                  @end
                </div>

                <details>
                  <summary class="cursor-pointer rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700">Editar este item</summary>
                  <div class="mt-4 border-t border-slate-100 pt-4">
                    <form method="POST" action="/admin/menus/items/{{ item.id }}" class="grid gap-4 md:grid-cols-2">
                      {{ csrfField() }}

                      <label><span class="mb-1 block text-sm font-semibold">Nome exibido</span><input name="label" value="{{ item.label }}" required></label>
                      <label><span class="mb-1 block text-sm font-semibold">Destino</span><select name="type" onchange="toggleMenuTarget(this.form)"><option value="page" {{ item.type === 'page' ? 'selected' : '' }}>Página do portal</option><option value="url" {{ item.type === 'url' ? 'selected' : '' }}>URL / seção existente</option></select></label>

                      <label data-page-target class="{{ item.type === 'page' ? '' : 'hidden' }}"><span class="mb-1 block text-sm font-semibold">Página</span><select name="pageId"><option value="">Selecione</option>@each(pageOption in pages)@if(pageOption)<option value="{{ pageOption.id }}" {{ item.pageId === pageOption.id ? 'selected' : '' }}>{{ pageOption.title }}</option>@end@end</select></label>
                      <label data-url-target class="{{ item.type === 'url' ? '' : 'hidden' }}"><span class="mb-1 block text-sm font-semibold">Endereço</span><input name="url" value="{{ item.url ?? '' }}"></label>

                      <label><span class="mb-1 block text-sm font-semibold">Posição</span><select name="parentId"><option value="">Menu principal</option>@each(rootOption in roots)@if(rootOption)@if(rootOption.id !== item.id)<option value="{{ rootOption.id }}" {{ item.parentId === rootOption.id ? 'selected' : '' }}>Dentro de “{{ rootOption.label }}”</option>@end@end@end</select></label>
                      <label><span class="mb-1 block text-sm font-semibold">Ordem</span><input type="number" name="position" value="{{ item.position }}"></label>

                      <div class="flex flex-wrap gap-5 md:col-span-2"><label class="flex items-center gap-2"><input class="w-auto" type="checkbox" name="isVisible" value="true" {{ item.isVisible ? 'checked' : '' }}> Mostrar no site</label><label class="flex items-center gap-2"><input class="w-auto" type="checkbox" name="openNewTab" value="true" {{ item.openNewTab ? 'checked' : '' }}> Abrir em nova aba</label></div>
                      <div class="md:col-span-2"><button class="rounded-lg bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white">Salvar alterações</button></div>
                    </form>

                    <form method="POST" action="/admin/menus/items/{{ item.id }}/delete" class="mt-3" onsubmit="return confirm('Remover este item do menu?')">
                      {{ csrfField() }}
                      <button class="admin-action admin-action--delete" type="submit">Excluir do menu</button>
                    </form>
                  </div>
                </details>
              </article>
            @end
          @else
            <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">Nenhum item configurado.</div>
          @end
        </div>
      </div>
    </div>
  </section>

  <script>
    function toggleMenuTarget(form) {
      if (!form) return
      const typeSelect = form.querySelector('[name="type"]')
      if (!typeSelect) return
      const type = typeSelect.value
      form.querySelectorAll('[data-page-target]').forEach((element) => element.classList.toggle('hidden', type !== 'page'))
      form.querySelectorAll('[data-url-target]').forEach((element) => element.classList.toggle('hidden', type !== 'url'))
    }
  </script>
@end

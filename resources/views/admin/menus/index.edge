@layout()
  <section class="mx-auto max-w-6xl px-6 py-10">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Conteúdo</p>
        <h1 class="mt-2 text-3xl font-bold">Menus</h1>
        <p class="mt-2 text-slate-600">Crie itens e submenus sem alterar o layout do portal.</p>
      </div>
      <a href="/admin/institutional-pages" class="admin-action admin-action--view">Gerenciar páginas</a>
    </div>

    <div class="grid gap-7 lg:grid-cols-[1fr_1.5fr]">
      <aside class="rounded-2xl border border-slate-200 bg-white p-5">
        <h2 class="text-xl font-bold">Adicionar item</h2>
        <p class="mt-1 text-sm text-slate-500">Para criar um submenu, selecione um item pai.</p>

        <form method="POST" action="/admin/menus/items" class="mt-5 space-y-4">
          {{ csrfField() }}

          <label>
            <span class="mb-1 block font-semibold">Nome exibido</span>
            <input name="label" required>
          </label>

          <label>
            <span class="mb-1 block font-semibold">Tipo</span>
            <select name="type" onchange="toggleMenuTarget(this.form)">
              <option value="page">Página do portal</option>
              <option value="url">URL / rota existente</option>
            </select>
          </label>

          <label data-page-target>
            <span class="mb-1 block font-semibold">Página</span>
            <select name="pageId">
              <option value="">Selecione</option>
              @each(pageOption in pages)
                @if(pageOption)
                  <option value="{{ pageOption.id }}">{{ pageOption.title }}</option>
                @end
              @end
            </select>
          </label>

          <label data-url-target class="hidden">
            <span class="mb-1 block font-semibold">URL</span>
            <input name="url" placeholder="/agenda ou https://...">
          </label>

          <label>
            <span class="mb-1 block font-semibold">Item pai</span>
            <select name="parentId">
              <option value="">Nenhum — item principal</option>
              @each(rootOption in roots)
                @if(rootOption)
                  <option value="{{ rootOption.id }}">{{ rootOption.label }}</option>
                @end
              @end
            </select>
          </label>

          <label>
            <span class="mb-1 block font-semibold">Ordem</span>
            <input type="number" name="position" value="10" min="0">
          </label>

          <label class="flex items-center gap-2">
            <input class="w-auto" type="checkbox" name="isVisible" value="true" checked>
            Visível
          </label>

          <label class="flex items-center gap-2">
            <input class="w-auto" type="checkbox" name="openNewTab" value="true">
            Abrir em nova aba
          </label>

          <button class="w-full rounded-lg bg-emerald-800 px-4 py-2.5 font-semibold text-white">Adicionar ao menu</button>
        </form>
      </aside>

      <div class="space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <h2 class="text-xl font-bold">Estrutura do menu</h2>
          <p class="mt-1 text-sm text-slate-500">Itens recuados pertencem ao submenu do item acima.</p>
        </div>

        @each(item in items)
          @if(item)
            <article class="rounded-xl border border-slate-200 bg-white p-4 {{ item.parentId ? 'ml-8 border-l-4 border-l-amber-400' : '' }}">
              <form method="POST" action="/admin/menus/items/{{ item.id }}" class="grid gap-3 md:grid-cols-[1.1fr_.9fr_.65fr_auto] md:items-end">
                {{ csrfField() }}

                <label>
                  <span class="text-xs font-semibold text-slate-500">Nome</span>
                  <input name="label" value="{{ item.label }}" required>
                </label>

                <label>
                  <span class="text-xs font-semibold text-slate-500">Destino</span>
                  <select name="type" onchange="toggleMenuTarget(this.form)">
                    <option value="page" {{ item.type === 'page' ? 'selected' : '' }}>Página</option>
                    <option value="url" {{ item.type === 'url' ? 'selected' : '' }}>URL</option>
                  </select>
                </label>

                <label>
                  <span class="text-xs font-semibold text-slate-500">Ordem</span>
                  <input type="number" name="position" value="{{ item.position }}">
                </label>

                <button class="rounded-lg bg-emerald-800 px-4 py-2.5 text-sm font-semibold text-white">Salvar</button>

                <label data-page-target class="md:col-span-2 {{ item.type === 'page' ? '' : 'hidden' }}">
                  <span class="text-xs font-semibold text-slate-500">Página</span>
                  <select name="pageId">
                    <option value="">Selecione</option>
                    @each(pageOption in pages)
                      @if(pageOption)
                        <option value="{{ pageOption.id }}" {{ item.pageId === pageOption.id ? 'selected' : '' }}>{{ pageOption.title }}</option>
                      @end
                    @end
                  </select>
                </label>

                <label data-url-target class="md:col-span-2 {{ item.type === 'url' ? '' : 'hidden' }}">
                  <span class="text-xs font-semibold text-slate-500">URL</span>
                  <input name="url" value="{{ item.url ?? '' }}">
                </label>

                <label>
                  <span class="text-xs font-semibold text-slate-500">Item pai</span>
                  <select name="parentId">
                    <option value="">Nenhum</option>
                    @each(rootOption in roots)
                      @if(rootOption)
                        @if(rootOption.id !== item.id)
                          <option value="{{ rootOption.id }}" {{ item.parentId === rootOption.id ? 'selected' : '' }}>{{ rootOption.label }}</option>
                        @end
                      @end
                    @end
                  </select>
                </label>

                <div class="flex flex-wrap gap-4 pb-2">
                  <label class="flex items-center gap-2">
                    <input class="w-auto" type="checkbox" name="isVisible" value="true" {{ item.isVisible ? 'checked' : '' }}>
                    Visível
                  </label>
                  <label class="flex items-center gap-2">
                    <input class="w-auto" type="checkbox" name="openNewTab" value="true" {{ item.openNewTab ? 'checked' : '' }}>
                    Nova aba
                  </label>
                </div>
              </form>

              <form method="POST" action="/admin/menus/items/{{ item.id }}/delete" class="mt-3" onsubmit="return confirm('Remover este item do menu?')">
                {{ csrfField() }}
                <button class="admin-action admin-action--delete" type="submit">Excluir</button>
              </form>
            </article>
          @end
        @end
      </div>
    </div>
  </section>

  <script>
    function toggleMenuTarget(form) {
      if (!form) return
      const typeSelect = form.querySelector('[name="type"]')
      if (!typeSelect) return
      const type = typeSelect.value
      form.querySelectorAll('[data-page-target]').forEach((element) => element.classList.toggle('hidden', type !== 'page'))
      form.querySelectorAll('[data-url-target]').forEach((element) => element.classList.toggle('hidden', type !== 'url'))
    }
  </script>
@end

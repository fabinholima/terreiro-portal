@layout()
  <div class="mx-auto max-w-5xl px-6 py-10">
    <div class="mb-8">
      <p class="text-sm font-medium text-emerald-700">Administração</p>
      <h1 class="mt-2 text-3xl font-bold">Configurações do site</h1>
      <p class="mt-2 text-slate-600">Edite a página inicial, identidade, contato, contribuição voluntária, rodapé e redes sociais.</p>
    </div>

    @if(flashMessages.has('success'))
      <div class="mb-6 rounded-lg bg-emerald-50 p-4 text-emerald-800">{{ flashMessages.get('success') }}</div>
    @end
    @if(flashMessages.has('error'))
      <div class="mb-6 rounded-lg bg-red-50 p-4 text-red-800">{{ flashMessages.get('error') }}</div>
    @end

    <form method="POST" enctype="multipart/form-data" action="/admin/site-settings" class="space-y-8 rounded-2xl border border-slate-200 bg-white p-6">
      {{ csrfField() }}

      <section class="space-y-5">
        <div><p class="text-sm font-medium text-emerald-700">Página inicial</p><h2 class="text-xl font-bold">Hero</h2></div>
        <label class="block"><span class="mb-2 block font-semibold">Chamada superior</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="homeEyebrow" value="{{ settings.homeEyebrow ?? 'Institucional' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Título principal</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="homeTitle" value="{{ settings.homeTitle ?? 'O Terreiro' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Texto de apresentação</span><textarea class="min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2" name="homeSummary">{{ settings.homeSummary ?? 'Casa de fé, caridade, ancestralidade e acolhimento.' }}</textarea></label>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <h2 class="text-xl font-bold">Nossa missão</h2>
        <label class="block"><span class="mb-2 block font-semibold">Título</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="missionTitle" value="{{ settings.missionTitle ?? 'Nossa missão' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Texto</span><textarea class="min-h-32 w-full rounded-lg border border-slate-300 px-3 py-2" name="missionText">{{ settings.missionText ?? '' }}</textarea></label>
        <label class="flex items-center gap-3"><input type="checkbox" name="missionVisible" value="true" {{ settings.missionVisible !== false ? 'checked' : '' }}><span class="font-semibold">Exibir este bloco na página inicial</span></label>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <h2 class="text-xl font-bold">Nossos valores</h2>
        <label class="block"><span class="mb-2 block font-semibold">Título</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="valuesTitle" value="{{ settings.valuesTitle ?? 'Nossos valores' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Texto</span><textarea class="min-h-32 w-full rounded-lg border border-slate-300 px-3 py-2" name="valuesText">{{ settings.valuesText ?? '' }}</textarea></label>
        <label class="flex items-center gap-3"><input type="checkbox" name="valuesVisible" value="true" {{ settings.valuesVisible !== false ? 'checked' : '' }}><span class="font-semibold">Exibir este bloco na página inicial</span></label>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <h2 class="text-xl font-bold">Nossa trajetória</h2>
        <label class="block"><span class="mb-2 block font-semibold">Título</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="trajectoryTitle" value="{{ settings.trajectoryTitle ?? 'Nossa trajetória' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Texto</span><textarea class="min-h-32 w-full rounded-lg border border-slate-300 px-3 py-2" name="trajectoryText">{{ settings.trajectoryText ?? '' }}</textarea></label>
        <div class="grid gap-5 md:grid-cols-2">
          <label class="block"><span class="mb-2 block font-semibold">Texto do botão</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="trajectoryButtonText" value="{{ settings.trajectoryButtonText ?? 'Conheça nossa história' }}"></label>
          <label class="block"><span class="mb-2 block font-semibold">Destino do botão</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="trajectoryButtonUrl" placeholder="/o-terreiro" value="{{ settings.trajectoryButtonUrl ?? '/o-terreiro' }}"></label>
        </div>
        <label class="flex items-center gap-3"><input type="checkbox" name="trajectoryVisible" value="true" {{ settings.trajectoryVisible !== false ? 'checked' : '' }}><span class="font-semibold">Exibir este bloco na página inicial</span></label>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <h2 class="text-xl font-bold">Identidade geral</h2>
        <label class="block"><span class="mb-2 block font-semibold">Nome institucional</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="siteName" required value="{{ settings.siteName }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Subtítulo</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="siteSubtitle" value="{{ settings.siteSubtitle ?? '' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Texto do rodapé</span><textarea class="min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2" name="footerText">{{ settings.footerText ?? '' }}</textarea></label>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <h2 class="text-xl font-bold">Endereço e atendimento</h2>
        <label class="block"><span class="mb-2 block font-semibold">Endereço</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="address" value="{{ settings.address ?? '' }}"></label>
        <div class="grid gap-5 md:grid-cols-3">
          <label class="block"><span class="mb-2 block font-semibold">Cidade</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="city" value="{{ settings.city ?? '' }}"></label>
          <label class="block"><span class="mb-2 block font-semibold">UF</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" maxlength="2" name="state" value="{{ settings.state ?? '' }}"></label>
          <label class="block"><span class="mb-2 block font-semibold">CEP</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="postalCode" value="{{ settings.postalCode ?? '' }}"></label>
        </div>
        <label class="block"><span class="mb-2 block font-semibold">Horários/orientações de atendimento</span><textarea class="min-h-28 w-full rounded-lg border border-slate-300 px-3 py-2" name="openingHours">{{ settings.openingHours ?? '' }}</textarea></label>
        <label class="block"><span class="mb-2 block font-semibold">Link do mapa</span><input type="url" class="w-full rounded-lg border border-slate-300 px-3 py-2" name="mapsUrl" placeholder="https://..." value="{{ settings.mapsUrl ?? '' }}"></label>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <h2 class="text-xl font-bold">Contato</h2>
        <div class="grid gap-5 md:grid-cols-2">
          <label class="block"><span class="mb-2 block font-semibold">Telefone</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="phone" value="{{ settings.phone ?? '' }}"></label>
          <label class="block"><span class="mb-2 block font-semibold">WhatsApp</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="whatsapp" value="{{ settings.whatsapp ?? '' }}"></label>
        </div>
        <label class="block"><span class="mb-2 block font-semibold">E-mail público</span><input type="email" class="w-full rounded-lg border border-slate-300 px-3 py-2" name="email" value="{{ settings.email ?? '' }}"></label>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <div>
          <p class="text-sm font-medium text-amber-700">Página de Contato</p>
          <h2 class="text-xl font-bold">Contribuição voluntária via PIX</h2>
          <p class="mt-1 text-sm text-slate-600">O card só aparece no portal quando esta opção estiver ativada. A contribuição é apresentada como espontânea e facultativa.</p>
        </div>
        <label class="flex items-center gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4">
          <input type="checkbox" name="contributionVisible" value="true" {{ settings.contributionVisible ? 'checked' : '' }}>
          <span class="font-semibold">Exibir card “Contribua com a casa” na página Contato</span>
        </label>
        <div class="grid gap-5 md:grid-cols-2">
          <label class="block"><span class="mb-2 block font-semibold">Título</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="contributionTitle" value="{{ settings.contributionTitle ?? 'Contribua com a casa' }}"></label>
          <label class="block"><span class="mb-2 block font-semibold">Favorecido</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="pixBeneficiary" placeholder="Nome do favorecido" value="{{ settings.pixBeneficiary ?? '' }}"></label>
        </div>
        <label class="block"><span class="mb-2 block font-semibold">Texto explicativo</span><textarea class="min-h-24 w-full rounded-lg border border-slate-300 px-3 py-2" name="contributionText">{{ settings.contributionText ?? 'Sua contribuição voluntária auxilia na manutenção das atividades religiosas, sociais e comunitárias do Terreiro.' }}</textarea></label>
        <label class="block"><span class="mb-2 block font-semibold">Chave PIX</span><input class="w-full rounded-lg border border-slate-300 px-3 py-2" name="pixKey" placeholder="CPF, CNPJ, e-mail, telefone ou chave aleatória" value="{{ settings.pixKey ?? '' }}"></label>
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
          <label class="block"><span class="mb-2 block font-semibold">Imagem do QR Code PIX</span><input type="file" name="pixQrCode" accept="image/png,image/jpeg,image/webp" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2"></label>
          <p class="mt-2 text-sm text-slate-500">PNG, JPG ou WebP, até 5 MB. Recomenda-se uma imagem quadrada e nítida.</p>
          @if(settings.pixQrCodePath)
            <div class="mt-4 flex flex-wrap items-center gap-5">
              <img src="{{ settings.pixQrCodePath }}" alt="QR Code PIX atual" class="h-36 w-36 rounded-xl border border-slate-200 bg-white object-contain p-2">
              <label class="flex items-center gap-2 text-sm font-semibold text-red-700"><input type="checkbox" name="removePixQrCode" value="true"> Remover QR Code atual ao salvar</label>
            </div>
          @end
        </div>
      </section>

      <section class="space-y-5 border-t border-slate-200 pt-7">
        <h2 class="text-xl font-bold">Redes sociais</h2>
        <label class="block"><span class="mb-2 block font-semibold">Instagram</span><input type="url" class="w-full rounded-lg border border-slate-300 px-3 py-2" name="instagramUrl" placeholder="https://instagram.com/..." value="{{ settings.instagramUrl ?? '' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">Facebook</span><input type="url" class="w-full rounded-lg border border-slate-300 px-3 py-2" name="facebookUrl" placeholder="https://facebook.com/..." value="{{ settings.facebookUrl ?? '' }}"></label>
        <label class="block"><span class="mb-2 block font-semibold">YouTube</span><input type="url" class="w-full rounded-lg border border-slate-300 px-3 py-2" name="youtubeUrl" placeholder="https://youtube.com/..." value="{{ settings.youtubeUrl ?? '' }}"></label>
      </section>

      <div class="flex justify-end border-t border-slate-200 pt-6"><button class="rounded-lg bg-emerald-800 px-5 py-3 font-semibold text-white" type="submit">Salvar configurações</button></div>
    </form>
  </div>
@end

@layout()
  <section class="mx-auto max-w-3xl px-6 py-12">
    <a href="/admin/users" class="text-sm font-semibold text-emerald-800 underline">← Voltar aos usuários</a>
    <div class="mt-6 mb-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-800">Administração</p>
      <h1 class="mt-2 text-3xl font-bold">{{ user ? 'Editar usuário' : 'Novo usuário' }}</h1>
    </div>

    @if(flashMessages.has('error'))
      <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">{{ flashMessages.get('error') }}</div>
    @end

    <form method="POST" action="{{ user ? '/admin/users/' + user.id : '/admin/users' }}" class="grid gap-5 rounded-xl border border-slate-200 bg-white p-6">
      {{ csrfField() }}

      <label class="grid gap-1.5">
        <span class="font-semibold">Nome completo</span>
        <input class="rounded-lg border border-slate-300 px-3 py-2" name="fullName" value="{{ user?.fullName ?? '' }}" required>
      </label>

      <label class="grid gap-1.5">
        <span class="font-semibold">E-mail</span>
        <input class="rounded-lg border border-slate-300 px-3 py-2" type="email" name="email" value="{{ user?.email ?? '' }}" required>
      </label>

      <label class="grid gap-1.5">
        <span class="font-semibold">Perfil</span>
        <select class="rounded-lg border border-slate-300 px-3 py-2" name="role" required>
          <option value="editor" @if(user?.role === 'editor') selected @end>Editor</option>
          <option value="admin" @if(user?.role === 'admin' || !user) selected @end>Administrador</option>
        </select>
        <span class="text-sm text-slate-500">Administradores gerenciam usuários e configurações. Editores gerenciam conteúdo.</span>
      </label>

      <label class="flex items-center gap-2">
        <input type="hidden" name="isActive" value="false">
        <input type="checkbox" name="isActive" value="true" @if(user?.isActive ?? true) checked @end>
        <span class="font-semibold">Usuário ativo</span>
      </label>

      <div class="grid gap-5 border-t border-slate-200 pt-5 md:grid-cols-2">
        <label class="grid gap-1.5">
          <span class="font-semibold">{{ user ? 'Nova senha' : 'Senha' }}</span>
          <input class="rounded-lg border border-slate-300 px-3 py-2" type="password" name="password" {{ user ? '' : 'required' }}>
          @if(user)
            <span class="text-sm text-slate-500">Deixe em branco para manter a senha atual.</span>
          @end
        </label>

        <label class="grid gap-1.5">
          <span class="font-semibold">Confirmar senha</span>
          <input class="rounded-lg border border-slate-300 px-3 py-2" type="password" name="passwordConfirmation" {{ user ? '' : 'required' }}>
        </label>
      </div>

      <div>
        <button type="submit" class="rounded-lg bg-emerald-800 px-5 py-2.5 font-semibold text-white">Salvar usuário</button>
      </div>
    </form>
  </section>
@end

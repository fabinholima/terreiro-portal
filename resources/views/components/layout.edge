<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c351f" />
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}" />
    <link rel="canonical" href="{{ seo.canonicalUrl }}" />

    @if(seo.noindex)
      <meta name="robots" content="noindex,nofollow" />
    @else
      <meta name="robots" content="index,follow" />
    @end

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="{{ seo.type }}" />
    <meta property="og:title" content="{{ seo.title }}" />
    <meta property="og:description" content="{{ seo.description }}" />
    <meta property="og:url" content="{{ seo.canonicalUrl }}" />
    <meta property="og:site_name" content="{{ siteSettings.siteName }}" />
    @if(seo.imageUrl)
      <meta property="og:image" content="{{ seo.imageUrl }}" />
    @end

    <meta name="twitter:card" content="{{ seo.imageUrl ? 'summary_large_image' : 'summary' }}" />
    <meta name="twitter:title" content="{{ seo.title }}" />
    <meta name="twitter:description" content="{{ seo.description }}" />
    @if(seo.imageUrl)
      <meta name="twitter:image" content="{{ seo.imageUrl }}" />
    @end

    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    @include('partials/header')
    <main>
      @include('partials/flash_alerts')
      {{{ await $slots.main() }}}
    </main>

    <footer class="site-footer">
      <div class="site-container site-footer__inner">
        <div>
          <div class="footer-brand">
            <img src="/images/logo-terreiro.svg" alt="">
            <div>
              <small>{{ siteSettings.siteSubtitle ?? 'Na fé, na lei e na caridade' }}</small>
              <strong>{{ siteSettings.siteName }}</strong>
            </div>
          </div>
          <p>{{ siteSettings.footerText ?? 'Casa de fé, caridade, ancestralidade e acolhimento.' }}</p>
          <div class="footer-social">
            @if(siteSettings.instagramUrl)
              <a href="{{ siteSettings.instagramUrl }}" target="_blank" rel="noopener">Instagram</a>
            @end
            @if(siteSettings.facebookUrl)
              <a href="{{ siteSettings.facebookUrl }}" target="_blank" rel="noopener">Facebook</a>
            @end
            @if(siteSettings.youtubeUrl)
              <a href="{{ siteSettings.youtubeUrl }}" target="_blank" rel="noopener">YouTube</a>
            @end
          </div>
        </div>

        @if(siteSettings.address || siteSettings.email || siteSettings.phone || siteSettings.whatsapp)
          <div>
            <h3>Contato</h3>
            @if(siteSettings.address)
              <p>{{ siteSettings.address }}</p>
            @end
            @if(siteSettings.city || siteSettings.state)
              <p>{{ siteSettings.city ?? '' }}{{ siteSettings.city && siteSettings.state ? ' - ' : '' }}{{ siteSettings.state ?? '' }}</p>
            @end
            @if(siteSettings.phone)
              <p>{{ siteSettings.phone }}</p>
            @end
            @if(siteSettings.whatsapp)
              <p>WhatsApp: {{ siteSettings.whatsapp }}</p>
            @end
            @if(siteSettings.email)
              <p><a href="mailto:{{ siteSettings.email }}">{{ siteSettings.email }}</a></p>
            @end
          </div>
        @end

        <div>
          <h3>Navegação</h3>
          <nav class="footer-links" aria-label="Navegação do rodapé">
            <a href="/o-terreiro">O Terreiro</a>
            <a href="/nossa-historia">História</a>
            <a href="/umbanda">Umbanda</a>
            <a href="/agenda">Agenda</a>
            <a href="/galeria">Galeria</a>
            <a href="/noticias">Notícias</a>
            <a href="/acoes-sociais">Ações sociais</a>
            <a href="/documentos">Documentos</a>
            <a href="/contato">Contato</a>
          </nav>
        </div>
      </div>
      <div class="site-footer__bottom">
        <div class="site-container">{{ siteSettings.siteName }} · Portal institucional</div>
      </div>
    </footer>
  </body>
</html>

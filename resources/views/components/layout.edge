<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}" />
    <link rel="canonical" href="{{ seo.canonicalUrl }}" />

    @if(seo.noindex)
      <meta name="robots" content="noindex,nofollow" />
    @else
      <meta name="robots" content="index,follow" />
    @end

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="{{ seo.type }}" />
    <meta property="og:title" content="{{ seo.title }}" />
    <meta property="og:description" content="{{ seo.description }}" />
    <meta property="og:url" content="{{ seo.canonicalUrl }}" />
    <meta property="og:site_name" content="{{ siteSettings.siteName }}" />
    @if(seo.imageUrl)
      <meta property="og:image" content="{{ seo.imageUrl }}" />
    @end

    <meta name="twitter:card" content="{{ seo.imageUrl ? 'summary_large_image' : 'summary' }}" />
    <meta name="twitter:title" content="{{ seo.title }}" />
    <meta name="twitter:description" content="{{ seo.description }}" />
    @if(seo.imageUrl)
      <meta name="twitter:image" content="{{ seo.imageUrl }}" />
    @end

    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="bg-white text-slate-900 antialiased">
    @include('partials/header')
    <main>
      @include('partials/flash_alerts')
      {{{ await $slots.main() }}}
    </main>
    <footer class="bg-slate-950 text-slate-200">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 md:grid-cols-3">
        <div>
          <strong class="text-white">{{ siteSettings.siteName }}</strong>
          @if(siteSettings.footerText)
            <p class="mt-2 text-sm text-slate-400">{{ siteSettings.footerText }}</p>
          @end
        </div>

        <div class="text-sm text-slate-400">
          @if(siteSettings.address)
            <p>{{ siteSettings.address }}</p>
          @end
          @if(siteSettings.city || siteSettings.state)
            <p>{{ siteSettings.city ?? '' }}{{ siteSettings.city && siteSettings.state ? ' - ' : '' }}{{ siteSettings.state ?? '' }}</p>
          @end
          @if(siteSettings.email)
            <p><a href="mailto:{{ siteSettings.email }}">{{ siteSettings.email }}</a></p>
          @end
        </div>

        <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm md:justify-end" aria-label="Navegação do rodapé">
          <a href="/agenda">Agenda</a>
          <a href="/galeria">Galeria</a>
          <a href="/acoes-sociais">Ações sociais</a>
          <a href="/noticias">Notícias</a>
          <a href="/documentos">Documentos</a>
          <a href="/contato">Contato</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

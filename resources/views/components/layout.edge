<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c351f" />
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}" />
    <link rel="canonical" href="{{ seo.canonicalUrl }}" />

    @if(seo.noindex)
      <meta name="robots" content="noindex,nofollow" />
    @else
      <meta name="robots" content="index,follow" />
    @end

    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="{{ seo.type }}" />
    <meta property="og:title" content="{{ seo.title }}" />
    <meta property="og:description" content="{{ seo.description }}" />
    <meta property="og:url" content="{{ seo.canonicalUrl }}" />
    <meta property="og:site_name" content="{{ siteSettings.siteName }}" />
    @if(seo.imageUrl)
      <meta property="og:image" content="{{ seo.imageUrl }}" />
    @end

    <meta name="twitter:card" content="{{ seo.imageUrl ? 'summary_large_image' : 'summary' }}" />
    <meta name="twitter:title" content="{{ seo.title }}" />
    <meta name="twitter:description" content="{{ seo.description }}" />
    @if(seo.imageUrl)
      <meta name="twitter:image" content="{{ seo.imageUrl }}" />
    @end

    @vite(['resources/css/app.css', 'resources/css/site-adjustments.css', 'resources/css/admin.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>

  @if(request.url().startsWith('/admin'))
    <body class="admin-body" x-data="{ adminMenuOpen: false }">
      <div class="admin-shell">
        <aside class="admin-sidebar" :class="adminMenuOpen ? 'is-open' : ''>
          <a class="admin-brand" href="/admin">
            <img src="/images/logo-terreiro.png" alt="">
            <span>
              <strong>Oxóssi e João Boiadeiro</strong>
              <small>Painel administrativo</small>
            </span>
          </a>

          <div>
            <div class="admin-nav-label">Principal</div>
            <nav class="admin-nav" aria-label="Administração">
              <a data-admin-link href="/admin"><span class="admin-nav__icon">▦</span>Dashboard</a>
            </nav>

            <div class="admin-nav-label">Conteúdo</div>
            <nav class="admin-nav">
              <a data-admin-link href="/admin/events"><span class="admin-nav__icon">◷</span>Agenda</a>
              <a data-admin-link href="/admin/posts"><span class="admin-nav__icon">▤</span>Notícias</a>
              <a data-admin-link href="/admin/albums"><span class="admin-nav__icon">▧</span>Galeria</a>
              <a data-admin-link href="/admin/social-actions"><span class="admin-nav__icon">♡</span>Ações sociais</a>
              <a data-admin-link href="/admin/documents"><span class="admin-nav__icon">▥</span>Documentos</a>
            </nav>

            <div class="admin-nav-label">Institucional</div>
            <nav class="admin-nav">
              <a data-admin-link href="/admin/institutional-pages"><span class="admin-nav__icon">▣</span>Páginas institucionais</a>
            </nav>

            @if(auth.user?.role === 'admin')
              <div class="admin-nav-label">Sistema</div>
              <nav class="admin-nav">
                <a data-admin-link href="/admin/site-settings"><span class="admin-nav__icon">⚙</span>Configurações</a>
                <a data-admin-link href="/admin/users"><span class="admin-nav__icon">♙</span>Usuários</a>
              </nav>
            @end
          </div>

          <div class="admin-sidebar__bottom">
            <a href="/" target="_blank" rel="noopener"><span>↗</span>Ver site público</a>
            <form method="POST" action="/logout">
              {{ csrfField() }}
              <button type="submit"><span>⇥</span>Sair</button>
            </form>
          </div>
        </aside>

        <div class="admin-main">
          <header class="admin-topbar">
            <div style="display:flex;align-items:center;gap:12px">
              <button class="admin-mobile-toggle" type="button" @click="adminMenuOpen = !adminMenuOpen" aria-label="Abrir menu">☰</button>
              <div class="admin-topbar__title">Painel administrativo</div>
            </div>
            <div class="admin-topbar__user">
              <span>{{ auth.user?.fullName ?? auth.user?.email }}</span>
              <span class="admin-avatar">{{ (auth.user?.fullName ?? auth.user?.email ?? 'A').charAt(0).toUpperCase() }}</span>
            </div>
          </header>

          <main class="admin-content" @click="adminMenuOpen = false">
            @include('partials/flash_alerts')
            {{{ await $slots.main() }}}
          </main>
        </div>
      </div>

      <script>
        (() => {
          const path = window.location.pathname
          document.querySelectorAll('[data-admin-link]').forEach((link) => {
            const href = link.getAttribute('href')
            const active = href === '/admin' ? path === '/admin' : path === href || path.startsWith(href + '/')
            if (active) link.classList.add('is-active')
          })
        })()
      </script>
    </body>
  @else

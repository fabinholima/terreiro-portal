    @stack('dumper')
  </head>
  <body class="bg-white text-slate-900 antialiased">
    @include('partials/header')
    <main>
      @include('partials/flash_alerts')
      {{{ await $slots.main() }}}
    </main>
    <footer class="bg-slate-950 text-slate-200">
      <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 md:grid-cols-3">
        <div>
          <strong class="text-white">{{ siteSettings.siteName }}</strong>
          @if(siteSettings.footerText)
            <p class="mt-2 text-sm text-slate-400">{{ siteSettings.footerText }}</p>
          @end
        </div>

        <div class="text-sm text-slate-400">
          @if(siteSettings.address)
            <p>{{ siteSettings.address }}</p>
          @end
          @if(siteSettings.city || siteSettings.state)
            <p>{{ siteSettings.city ?? '' }}{{ siteSettings.city && siteSettings.state ? ' - ' : '' }}{{ siteSettings.state ?? '' }}</p>
          @end
          @if(siteSettings.email)
            <p><a href="mailto:{{ siteSettings.email }}">{{ siteSettings.email }}</a></p>
          @end
        </div>

        <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm md:justify-end" aria-label="Navegação do rodapé">
          <a href="/agenda">Agenda</a>
